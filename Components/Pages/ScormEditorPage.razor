@page "/editor"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ScormPackageStore Store

<PageTitle>SCORM Editor</PageTitle>

<div class="scorm-editor">
    <div class="se-toolbar">
        <div class="se-title">
            <h3 class="mb-0">@(Package?.Manifest?.CourseTitle is { Length: > 0 } t ? t : "SCORM Editor")</h3>
            @if (Package is not null)
            {
                <span class="text-muted small text-truncate" title="@Package.FileName">@Package.FileName</span>
                <span class="badge text-bg-primary">@(Package.Manifest?.Version ?? "No manifest")</span>
                @if (Package.ChangeCount > 0)
                {
                    <button type="button" class="badge text-bg-warning border-0" title="See every change since the package was opened" @onclick="ReviewPackage">
                        @Package.ChangeCount @(Package.ChangeCount == 1 ? "changed file" : "changed files")
                    </button>
                }
            }
        </div>
        <div class="se-actions">
            <label class="btn btn-sm btn-outline-primary mb-0 @(loading ? "disabled" : "")">
                <span class="oi oi-folder me-1" aria-hidden="true"></span>@(loading ? "Opening…" : "Open package…")
                <InputFile OnChange="OpenZip" accept=".zip,application/zip" class="d-none" />
            </label>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadSample">Load sample</button>
            @if (Package is not null)
            {
                <button type="button" class="btn btn-sm btn-primary" @onclick="Export">
                    <span class="oi oi-data-transfer-download me-1" aria-hidden="true"></span>Export .zip
                </button>
            }
        </div>
    </div>

    @if (status is not null)
    {
        <div class="alert alert-@statusKind alert-dismissible py-2 mb-2 small" role="status">
            @status
            <button type="button" class="btn-close py-2" aria-label="Dismiss" @onclick="() => status = null"></button>
        </div>
    }

    <div class="se-grid @(sideOpen ? null : "side-closed")">
        @* Package: course structure, manifest facts and the file tree. It folds into a thin rail to
           give the editor the full width. *@
        @if (!sideOpen)
        {
            <nav class="se-pane se-rail" aria-label="Package">
                <button type="button" class="btn btn-sm btn-link" title="Show course structure and files" aria-label="Show course structure and files" @onclick="ToggleSide">
                    <span class="oi oi-chevron-right" aria-hidden="true"></span>
                </button>
                <span class="se-rail-label">Course structure</span>
            </nav>
        }
        <section class="se-pane se-side" aria-label="Package" hidden="@(!sideOpen)">
            <div class="se-pane-header">
                <span class="flex-grow-1">Course structure</span>
                <button type="button" class="btn btn-sm btn-link p-0" title="Hide this pane to make the editor wider" aria-label="Hide course structure" @onclick="ToggleSide">
                    <span class="oi oi-chevron-left" aria-hidden="true"></span>
                </button>
            </div>
            <div class="se-pane-body">
                @if (Package?.Manifest is null)
                {
                    <p class="small text-muted px-2 mb-2">@(Package is null ? "Open a package to begin." : "No imsmanifest.xml in this package.")</p>
                }
                else if (Package.Manifest.Error is not null)
                {
                    <p class="small text-danger px-2 mb-2">imsmanifest.xml has an XML error. @Package.Manifest.Error</p>
                }
                else
                {
                    <ol class="se-org">
                        @foreach (var (item, i) in Package.Manifest.Items.Select((it, i) => (it, i)))
                        {
                            <li>
                                <button type="button" class="@(item.Path is not null && item.Path == previewPath ? "current" : null)"
                                        style="padding-left: @(6 + item.Depth * 14)px" disabled="@(item.Path is null)"
                                        title="@(item.Path is null && item.Href is not null ? $"Missing file: {item.Href}" : item.Path)"
                                        @onclick="() => OpenItem(item)">
                                    <span class="se-ix">@(i + 1)</span><span>@item.Title</span>
                                </button>
                            </li>
                        }
                    </ol>
                    <dl class="se-meta">
                        <dt>Launch</dt><dd>@(Package.Manifest.LaunchPath ?? "—")</dd>
                        <dt>Identifier</dt><dd>@Package.Manifest.Identifier</dd>
                        <dt>Resources</dt><dd>@Package.Manifest.Resources.Count</dd>
                    </dl>
                }

                <div class="se-section-label">
                    <span>Files</span>
                    @if (Package is not null) { <span>@Package.Paths.Count</span> }
                </div>
                @if (Package is not null)
                {
                    <ul class="se-tree">@RenderFolder(TreeFor(Package.Paths), "")</ul>
                }
            </div>
            @if (Package is not null)
            {
                <div class="se-side-footer">
                    <form class="input-group input-group-sm" @onsubmit="AddFile" @onsubmit:preventDefault>
                        <input class="form-control" placeholder="folder/new-page.html" aria-label="New file path" @bind="newPath" />
                        <button class="btn btn-outline-secondary" type="submit">Add</button>
                    </form>
                    <div class="d-flex gap-1 flex-wrap">
                        <label class="btn btn-sm btn-outline-secondary mb-0" title="Add files to the folder of the selected file">
                            <span class="oi oi-cloud-upload me-1" aria-hidden="true"></span>Upload
                            <InputFile OnChange="UploadFiles" multiple class="d-none" />
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SyncManifest"
                                title="List every package file in the launch resource of imsmanifest.xml">
                            <span class="oi oi-list me-1" aria-hidden="true"></span>Sync manifest
                        </button>
                    </div>
                    @if (currentPath is not null)
                    {
                        <div class="input-group input-group-sm">
                            <input class="form-control" aria-label="Rename selected file" @bind="renamePath" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="RenameFile">Rename</button>
                            <button class="btn btn-outline-danger" type="button" @onclick="DeleteFile">@(confirmDelete ? "Confirm" : "Delete")</button>
                        </div>
                    }
                </div>
            }
        </section>

        @* Main work area: Preview and Code tabs. Both panels stay in the DOM so the course keeps its
           state and CodeMirror keeps its undo history while the other tab is showing. *@
        <section class="se-pane se-main" aria-label="Editor">
            <div class="se-tabs" role="tablist">
                <button type="button" role="tab" class="se-tab @(tab == Tab.Preview ? "active" : null)" aria-selected="@(tab == Tab.Preview)" @onclick="() => ShowTab(Tab.Preview)">
                    <span class="oi oi-eye me-1" aria-hidden="true"></span>Preview
                    @if (previewPath is not null) { <span class="se-tab-file">@previewPath.Split('/')[^1]</span> }
                </button>
                <button type="button" role="tab" class="se-tab @(tab == Tab.Code ? "active" : null)" aria-selected="@(tab == Tab.Code)" @onclick="() => ShowTab(Tab.Code)">
                    <span class="oi oi-code me-1" aria-hidden="true"></span>Code
                    @if (currentPath is not null)
                    {
                        <span class="se-tab-file">@currentPath.Split('/')[^1]</span>
                        @if (Package?.IsDirty(currentPath) == true) { <span class="se-dot" title="Changed"></span> }
                    }
                </button>
                <div class="se-tab-tools">
                    @if (tab == Tab.Code)
                    {
                        <span class="se-path text-truncate">@(currentPath ?? "—")</span>
                        <button type="button" class="btn btn-sm btn-link" @onclick="Reindent" disabled="@(currentPath is null || !ScormPackage.IsText(currentPath))">Re-indent</button>
                        <button type="button" class="btn btn-sm btn-link" @onclick="RevertFile"
                                disabled="@(currentPath is null || Package is null || !Package.HasOriginal(currentPath) || !Package.IsDirty(currentPath))">Revert file</button>
                    }
                </div>
            </div>

            <div class="se-panel" role="tabpanel" aria-label="Preview" hidden="@(tab != Tab.Preview)">
                <div class="se-preview-tools">
                <select class="form-select form-select-sm se-addr" aria-label="Page to preview" value="@previewPath" @onchange="e => PickPreview(e.Value?.ToString())">
                    @if (Package is not null)
                    {
                        @foreach (var p in Package.Paths.Where(ScormPackage.IsHtml))
                        {
                            <option value="@p">@p@(p == Package.Manifest?.LaunchPath ? "  (launch)" : "")</option>
                        }
                    }
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Reload preview" @onclick="ReloadPreview"><span class="oi oi-reload"></span></button>
                <div class="btn-group btn-group-sm" role="group" aria-label="Preview width">
                    @foreach (var (label, w) in Widths)
                    {
                        <button type="button" class="btn @(frameWidth == w ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => frameWidth = w">@label</button>
                    }
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Preview mode">
                    <button type="button" class="btn @(previewMode == PreviewMode.Edit ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetMode(PreviewMode.Edit)"
                            title="Click any text in the page and type; right-click links, embeds and images to edit them">
                        <span class="oi oi-pencil me-1" aria-hidden="true"></span>Edit
                    </button>
                    <button type="button" class="btn @(previewMode == PreviewMode.Interact ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetMode(PreviewMode.Interact)"
                            title="Use the course as a learner: links, buttons and quizzes work">
                        <span class="oi oi-media-play me-1" aria-hidden="true"></span>Interact
                    </button>
                </div>
                <div class="form-check form-switch mb-0 small">
                    <input class="form-check-input" type="checkbox" id="se-live" checked="@live" @onchange="ToggleLive" />
                    <label class="form-check-label" for="se-live">Live</label>
                </div>
                </div>
            @if (previewMode == PreviewMode.Edit)
            {
                <div class="se-editbar">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Formatting">
                        <button type="button" class="btn btn-light" title="Bold (Ctrl+B)" @onclick='() => Exec("bold")' @onmousedown:preventDefault><b>B</b></button>
                        <button type="button" class="btn btn-light" title="Italic (Ctrl+I)" @onclick='() => Exec("italic")' @onmousedown:preventDefault><i>I</i></button>
                        <button type="button" class="btn btn-light" title="Underline (Ctrl+U)" @onclick='() => Exec("underline")' @onmousedown:preventDefault><u>U</u></button>
                        <button type="button" class="btn btn-light" title="Make a link" @onclick='() => Exec("createLink")' @onmousedown:preventDefault><span class="oi oi-link-intact"></span></button>
                        <button type="button" class="btn btn-light" title="Remove formatting" @onclick='() => Exec("removeFormat")' @onmousedown:preventDefault><span class="oi oi-ban"></span></button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="History">
                        <button type="button" class="btn btn-light" title="Undo (Ctrl+Z)" @onclick='() => Exec("undo")' @onmousedown:preventDefault><span class="oi oi-action-undo"></span></button>
                        <button type="button" class="btn btn-light" title="Redo (Ctrl+Y)" @onclick='() => Exec("redo")' @onmousedown:preventDefault><span class="oi oi-action-redo"></span></button>
                    </div>
                    <span class="flex-grow-1 se-edit-status">
                        @if (draftPaths.Length > 0)
                        {
                            <strong>Unsaved changes</strong>
                            @($" on {string.Join(", ", draftPaths)}. Review them to save.")
                        }
                        else
                        {
                            @("Click text and type. Right-click a link, embed or image to edit it. Switch to Interact to click through the course.")
                        }
                    </span>
                    @if (draftPaths.Length > 0)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DiscardDrafts">Discard</button>
                        <button type="button" class="btn btn-sm btn-primary" title="See what changed, then save (Ctrl+S)" @onclick="() => ReviewDrafts(null)">
                            <span class="oi oi-check me-1" aria-hidden="true"></span>Review and save
                        </button>
                    }
                </div>
            }
            <div class="se-stage @(frameWidth is null ? "" : "narrow")">
                <iframe @ref="frame" title="Course preview" style="@(frameWidth is null ? "" : $"width:{frameWidth}px")"></iframe>
            </div>
            <div class="se-lms" @ref="lmsHost"></div>
            </div>

            @* CodeMirror owns the host element; Blazor only renders the overlay beside it. *@
            <div class="se-panel" role="tabpanel" aria-label="Code" hidden="@(tab != Tab.Code)">
            <div class="se-editor-wrap">
                <div class="se-editor" @ref="editorHost"></div>
                @if (currentPath is null || !ScormPackage.IsText(currentPath))
                {
                    <div class="se-editor-blank">
                        @if (currentPath is null)
                        {
                            <span class="text-muted">Pick a file on the left to edit its source.</span>
                        }
                        else
                        {
                            @if (ScormPreviewEndpoints.ContentTypeOf(currentPath).StartsWith("image/"))
                            {
                                <img src="@PreviewUrl(currentPath)?v=@version" alt="@currentPath" />
                            }
                            <span class="text-muted small">@currentPath · @FormatSize(Package?.Read(currentPath)?.Length ?? 0) · @ScormPreviewEndpoints.ContentTypeOf(currentPath)</span>
                            <label class="btn btn-sm btn-outline-primary mb-0">
                                Replace file…
                                <InputFile OnChange="ReplaceFile" class="d-none" />
                            </label>
                        }
                    </div>
                }
            </div>
            </div>
        </section>
    </div>

    @if (review is not null)
    {
        <div class="se-review-backdrop">
            <div class="se-review" role="dialog" aria-modal="true" aria-labelledby="se-review-title">
                <div class="se-review-head">
                    <h5 id="se-review-title" class="mb-0">@(review.Drafts ? "Review changes before saving" : "Changes since the package was opened")</h5>
                    @if (review.Files.Count > 0)
                    {
                        <span class="text-muted small">
                            @review.Files.Count @(review.Files.Count == 1 ? "file" : "files") ·
                            <span class="se-plus">+@review.Files.Sum(f => f.Diff?.Added ?? 0)</span>
                            <span class="se-minus">−@review.Files.Sum(f => f.Diff?.Removed ?? 0)</span> lines
                        </span>
                    }
                </div>
                @if (review.Note is not null)
                {
                    <div class="alert alert-info py-2 px-3 mb-0 rounded-0 small">@review.Note</div>
                }
                <div class="se-review-body">
                    @if (review.Problems is { Count: > 0 } problems)
                    {
                        <div class="alert alert-warning py-2 px-3 small">
                            <strong>@problems.Count @(problems.Count == 1 ? "edit" : "edits") can't be saved as they are and will be left out:</strong>
                            <ul class="mb-0 ps-3">
                                @foreach (var pr in problems)
                                {
                                    <li>
                                        <span class="fw-semibold">@pr.What</span> on @pr.Page. @pr.Why
                                        @if (pr.Places > 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-dark py-0 ms-1" @onclick="() => ChangeAllPlaces(pr.Edit)">Change all @pr.Places places</button>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    @if (review.Files.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0">@(review.Drafts ? (review.Problems is { Count: > 0 } ? "Nothing else to save." : "The edits cancel out, so there is nothing to save.") : "Nothing has changed yet.")</p>
                    }
                    @foreach (var f in review.Files)
                    {
                        <section class="se-diff-file">
                            <header>
                                <span class="se-diff-path">@f.Path</span>
                                <span class="small text-muted">
                                    @f.Label
                                    @if (f.Diff is { TooLarge: false } d)
                                    {
                                        <span class="se-plus ms-2">+@d.Added</span>
                                        <span class="se-minus ms-1">−@d.Removed</span>
                                    }
                                </span>
                            </header>
                            @if (f.Warning is not null)
                            {
                                <div class="alert alert-warning py-1 px-2 m-2 small">@f.Warning</div>
                            }
                            @if (f.Diff is { TooLarge: true })
                            {
                                <p class="small text-muted px-2 py-1 mb-0">The change is too large to show line by line.</p>
                            }
                            else if (f.Diff is not null)
                            {
                                <table class="se-diff">
                                    @foreach (var (hunk, h) in f.Diff.Hunks.Select((x, i) => (x, i)))
                                    {
                                        @if (h > 0)
                                        {
                                            <tr class="se-diff-gap"><td colspan="3">⋯</td></tr>
                                        }
                                        @foreach (var line in hunk.Lines)
                                        {
                                            <tr class="se-diff-@line.Kind.ToString().ToLowerInvariant()">
                                                <td class="se-ln">@line.OldNumber</td>
                                                <td class="se-ln">@line.NewNumber</td>
                                                <td class="se-code"><span class="se-sign">@(line.Kind switch { TextDiff.Kind.Added => "+", TextDiff.Kind.Removed => "−", _ => " " })</span>@foreach (var seg in line.Segments)
                                                    {
                                                        if (seg.Changed) { <mark>@seg.Text</mark> } else { @seg.Text }
                                                    }</td>
                                            </tr>
                                        }
                                    }
                                </table>
                            }
                        </section>
                    }
                </div>
                <div class="se-review-foot">
                    @if (review.Drafts)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger me-auto" @onclick="DiscardDrafts">Discard changes</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseReview">Keep editing</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveDrafts" disabled="@(review.Files.Count == 0)">
                            <span class="oi oi-check me-1" aria-hidden="true"></span>Save changes
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary" @onclick="CloseReview">Close</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly (string Label, int? Width)[] Widths = [("Full", null), ("Tablet", 768), ("Phone", 390)];

    private ScormPackage? Package;
    private IJSObjectReference? module;
    private DotNetObjectReference<ScormEditorPage>? selfRef;
    private ElementReference editorHost, frame, lmsHost;

    private string? currentPath, previewPath, newPath, renamePath, status;
    private string statusKind = "info";
    private bool live = true, loading, confirmDelete;
    private enum PreviewMode { Edit, Interact }
    private PreviewMode previewMode = PreviewMode.Edit;
    private string[] draftPaths = [];
    private bool sideOpen = true;
    private Review? review;
    private int? frameWidth;
    private enum Tab { Preview, Code }
    private Tab tab = Tab.Preview;
    private bool refreshEditor;
    private int version;
    private readonly HashSet<string> collapsed = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (refreshEditor && module is not null)
        {
            refreshEditor = false;
            await module.InvokeVoidAsync("refresh");
        }
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scorm-editor.js");
        selfRef = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("init", selfRef, frame, editorHost, lmsHost);
        await OpenPackage(SamplePackage.Create());
    }

    private async Task OpenPackage(ScormPackage package)
    {
        if (Package is not null)
        {
            Package.Changed -= OnPackageChanged;
            Store.Remove(Package.Id);
        }
        Package = package;
        Store.Add(package);
        package.Changed += OnPackageChanged;
        draftPaths = [];
        review = null;
        currentPath = null;
        tab = Tab.Preview;
        collapsed.Clear();
        await module!.InvokeVoidAsync("setPackage", package.Id);

        var start = package.Manifest?.LaunchPath ?? package.Paths.FirstOrDefault(ScormPackage.IsHtml);
        await OpenFile(start ?? (package.ManifestPath.Length > 0 ? package.ManifestPath : package.Paths.FirstOrDefault()));
        await SetPreview(start);
    }

    // Raised from the preview endpoint's request thread as well as from this circuit.
    // Raised for every save, so re-renders are batched: one per 250 ms at most. Re-rendering the
    // whole page and file tree on each keystroke was the main source of lag on large courses.
    private int renderQueued;
    private void OnPackageChanged(string path)
    {
        if (Interlocked.Exchange(ref renderQueued, 1) == 1) return;
        _ = Task.Delay(250).ContinueWith(_ => InvokeAsync(() =>
        {
            renderQueued = 0;
            version++;
            StateHasChanged();
        }));
    }

    private async Task OpenZip(InputFileChangeEventArgs e)
    {
        loading = true;
        try
        {
            await using var upload = e.File.OpenReadStream(maxAllowedSize: 1024L * 1024 * 1024);
            using var ms = new MemoryStream();
            await upload.CopyToAsync(ms);
            ms.Position = 0;
            var package = ScormPackage.FromZip(e.File.Name, ms);
            if (draftPaths.Length > 0)
                Show($"Unsaved preview changes on {string.Join(", ", draftPaths)} were dropped when {e.File.Name} was opened.", "warning");
            await OpenPackage(package);
            if (status is null || statusKind != "warning") Show(package.ManifestPath.Length == 0
                ? $"Opened {e.File.Name}, but it has no imsmanifest.xml, so it is not a SCORM package yet."
                : $"Opened {e.File.Name} ({package.Paths.Count} files).", package.ManifestPath.Length == 0 ? "warning" : "success");
        }
        catch (InvalidDataException)
        {
            Show($"{e.File.Name} is not a readable .zip file.", "danger");
        }
        catch (IOException ex)
        {
            Show($"Could not read {e.File.Name}: {ex.Message}", "danger");
        }
        finally
        {
            loading = false;
        }
    }

    private Task LoadSample() => AfterDrafts(() => OpenPackage(SamplePackage.Create()));

    private async Task OpenFile(string? path)
    {
        if (Package is null || path is null || !Package.Exists(path)) return;
        currentPath = path;
        renamePath = path;
        confirmDelete = false;
        if (ScormPackage.IsText(path))
            await module!.InvokeVoidAsync("openText", path, Package.ReadText(path), ModeOf(path), false);
        else
            await module!.InvokeVoidAsync("hideEditor");
        if (live && draftPaths.Length == 0 && ScormPackage.IsHtml(path) && path != previewPath) await SetPreview(path);
    }

    private async Task EditFile(string path)
    {
        await OpenFile(path);
        ShowTab(Tab.Code);
    }

    private Task PreviewPage(string path) => AfterDrafts(async () =>
    {
        await SetPreview(path);
        ShowTab(Tab.Preview);
    });

    private Task OpenItem(ScormManifest.Item item) => AfterDrafts(async () =>
    {
        if (item.Path is null) return;
        await OpenFile(item.Path);
        await SetPreview(item.Path);
        ShowTab(Tab.Preview);
    });

    private Task PickPreview(string? path) => AfterDrafts(() => SetPreview(path));

    private async Task SetPreview(string? path)
    {
        previewPath = path;
        await module!.InvokeVoidAsync("loadPreview", path);
    }

    private Task ReloadPreview() => AfterDrafts(async () =>
    {
        await module!.InvokeVoidAsync("flush");
        await module!.InvokeVoidAsync("reloadPreview");
    });

    private async Task ToggleLive(ChangeEventArgs e)
    {
        live = e.Value is true;
        await module!.InvokeVoidAsync("setLive", live);
    }

    private Task SetMode(PreviewMode mode) => mode == previewMode ? Task.CompletedTask : AfterDrafts(async () =>
    {
        previewMode = mode;
        await module!.InvokeVoidAsync("setMode", mode == PreviewMode.Edit ? "edit" : "interact");
    });

    private async Task Exec(string command) => await module!.InvokeVoidAsync("exec", command);

    private void ToggleSide()
    {
        sideOpen = !sideOpen;
        refreshEditor = true;
    }

    private Task Export() => AfterDrafts(async () =>
    {
        await module!.InvokeVoidAsync("flush");
        await module!.InvokeVoidAsync("download", $"scorm-export/{Package!.Id}");
    });

    [JSInvokable]
    public Task OnPreviewNavigated(string path) => InvokeAsync(() => { previewPath = path; StateHasChanged(); });

    [JSInvokable]
    public Task OnDraftsChanged(string[] paths) => InvokeAsync(() => { draftPaths = paths; StateHasChanged(); });

    [JSInvokable]
    public Task OnReviewRequested() => InvokeAsync(() => ReviewDrafts(null));

    [JSInvokable]
    public Task OnImageReplaced(string path) => InvokeAsync(() => Show($"Replaced image {path}.", "success"));

    /* ---------- review ---------- */

    // One file in the review: the text that will be saved and its diff against what is saved now.
    private sealed record ReviewFile(string Path, string Label, string? NewText, TextDiff.Result? Diff, string? Warning);

    private sealed record Review(bool Drafts, List<ReviewFile> Files, string? Note, Func<Task>? Then,
        IReadOnlyList<EditMapper.Problem>? Problems = null, EditMapper.Edit[]? Edits = null, HashSet<int>? ChangeAll = null);

    // Runs an action that would reload the preview. With unsaved preview edits it opens the
    // review first, and runs the action once they are saved or discarded.
    private async Task AfterDrafts(Func<Task> action)
    {
        if (draftPaths.Length == 0) { await action(); return; }
        await ReviewDrafts(action);
    }

    private async Task ReviewDrafts(Func<Task>? then)
    {
        if (Package is null || module is null) return;
        var edits = await module.InvokeAsync<EditMapper.Edit[]>("getDrafts");
        review = BuildReview(edits, [], then);
        StateHasChanged();
    }

    private Review BuildReview(EditMapper.Edit[] edits, HashSet<int> changeAll, Func<Task>? then)
    {
        var result = EditMapper.Apply(Package!, edits, changeAll);
        var files = result.Files
            .Select(f => new ReviewFile(f.Path, "changed by your edits", f.NewText, TextDiff.Compare(f.OldDisplay, f.NewDisplay),
                f.Notes.Count == 0 ? null : string.Join(" ", f.Notes)))
            .ToList();
        return new Review(true, files,
            then is null ? null : "Save or discard these changes first. The preview reloads afterwards, which would lose them.", then,
            result.Problems, edits, changeAll);
    }

    // The user chose to change every copy of a text found in several places.
    private void ChangeAllPlaces(int edit)
    {
        if (review is not { Edits: { } edits, ChangeAll: { } all }) return;
        review = BuildReview(edits, [.. all, edit], review.Then);
    }

    private void ReviewPackage()
    {
        if (Package is null) return;
        var files = new List<ReviewFile>();
        foreach (var path in Package.ChangedPaths)
        {
            var original = Package.ReadOriginalText(path);
            var exists = Package.Exists(path);
            var label = original is null && !Package.HasOriginal(path) ? "added" : !exists ? "deleted" : "changed";
            if (!ScormPackage.IsText(path))
            {
                files.Add(new ReviewFile(path, label + " (binary file)", null, null, null));
                continue;
            }
            files.Add(new ReviewFile(path, label, null, TextDiff.Compare(original ?? "", exists ? Package.ReadText(path) : ""), null));
        }
        review = new Review(false, files, draftPaths.Length > 0 ? "Unsaved preview edits are not included until you save them." : null, null);
    }

    private async Task SaveDrafts()
    {
        if (Package is null || review is not { Drafts: true } r) return;
        foreach (var f in r.Files)
        {
            Package.WriteText(f.Path, f.NewText!);
            await module!.InvokeVoidAsync("updateDoc", f.Path, f.NewText);
        }
        review = null;
        await module!.InvokeVoidAsync("clearDrafts", r.Then is null);
        draftPaths = [];
        Show($"Saved {string.Join(", ", r.Files.Select(f => f.Path))}.", "success");
        if (r.Then is not null) await r.Then();
    }

    private async Task DiscardDrafts()
    {
        var then = review?.Then;
        review = null;
        // Always reload so the preview drops the discarded edits.
        await module!.InvokeVoidAsync("clearDrafts", true);
        draftPaths = [];
        Show("Discarded the unsaved preview changes.", "info");
        if (then is not null) await then();
    }

    private void CloseReview() => review = null;

    private async Task Reindent() => await module!.InvokeVoidAsync("reindent");

    private async Task RevertFile()
    {
        if (Package is null || currentPath is null) return;
        Package.Revert(currentPath);
        if (ScormPackage.IsText(currentPath))
            await module!.InvokeVoidAsync("openText", currentPath, Package.ReadText(currentPath), ModeOf(currentPath), true);
        await module!.InvokeVoidAsync("reloadPreview");
        Show($"Reverted {currentPath} to the version in the opened package.", "info");
    }

    private async Task AddFile()
    {
        if (Package is null) return;
        var path = ScormPackage.Normalize(newPath ?? "");
        if (path.Length == 0) return;
        if (Package.Exists(path)) { Show($"{path} already exists.", "warning"); return; }
        var text = ScormPackage.IsHtml(path)
            ? "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>New page</title>\n</head>\n<body>\n  <h1>New page</h1>\n</body>\n</html>\n"
            : "";
        Package.WriteText(path, text);
        newPath = null;
        await EditFile(path);
    }

    private async Task UploadFiles(InputFileChangeEventArgs e)
    {
        if (Package is null) return;
        var dir = currentPath is null ? "" : ScormPackage.DirOf(currentPath);
        var count = 0;
        foreach (var file in e.GetMultipleFiles(500))
        {
            var path = ScormPackage.Normalize($"{dir}/{file.Name}");
            Package.Write(path, await ReadAll(file));
            await module!.InvokeVoidAsync("forget", path);
            count++;
        }
        await module!.InvokeVoidAsync("reloadPreview");
        Show($"Added {count} file{(count == 1 ? "" : "s")} to {(dir.Length == 0 ? "the package root" : dir)}.", "success");
    }

    private async Task ReplaceFile(InputFileChangeEventArgs e)
    {
        if (Package is null || currentPath is null) return;
        Package.Write(currentPath, await ReadAll(e.File));
        await module!.InvokeVoidAsync("reloadPreview");
        Show($"Replaced {currentPath}.", "success");
    }

    private async Task RenameFile()
    {
        if (Package is null || currentPath is null) return;
        var to = ScormPackage.Normalize(renamePath ?? "");
        if (to.Length == 0 || to == currentPath) return;
        if (Package.Exists(to)) { Show($"{to} already exists.", "warning"); return; }
        var from = currentPath;
        Package.Rename(from, to);
        await module!.InvokeVoidAsync("forget", from);
        if (previewPath == from) await SetPreview(to);
        await OpenFile(to);
        Show($"Renamed {from} to {to}. Links to the old name are not updated.", "info");
    }

    private async Task DeleteFile()
    {
        if (Package is null || currentPath is null) return;
        if (!confirmDelete) { confirmDelete = true; return; }
        var path = currentPath;
        Package.Delete(path);
        await module!.InvokeVoidAsync("forget", path);
        currentPath = null;
        confirmDelete = false;
        if (previewPath == path) await SetPreview(Package.Manifest?.LaunchPath);
        Show($"Deleted {path}.", "info");
    }

    private async Task SyncManifest()
    {
        if (Package is null) return;
        var count = Package.SyncManifestFileList();
        if (count is null) { Show("Open a package with a valid imsmanifest.xml and at least one resource first.", "warning"); return; }
        if (currentPath == Package.ManifestPath)
            await module!.InvokeVoidAsync("openText", currentPath, Package.ReadText(currentPath), ModeOf(currentPath), true);
        else
            await module!.InvokeVoidAsync("forget", Package.ManifestPath);
        Show($"imsmanifest.xml now lists {count} files in the launch resource.", "success");
    }

    private void ShowTab(Tab next)
    {
        if (tab == next) return;
        tab = next;
        _ = module?.InvokeVoidAsync("setPreviewVisible", next == Tab.Preview).AsTask();
        // CodeMirror cannot measure itself while hidden, so it is refreshed once the Code tab is visible.
        if (next == Tab.Code) refreshEditor = true;
    }

    private void Show(string message, string kind)
    {
        status = message;
        statusKind = kind;
        StateHasChanged();
    }

    private string PreviewUrl(string path) =>
        $"scorm-preview/{Package!.Id}/{string.Join('/', path.Split('/').Select(Uri.EscapeDataString))}";

    private static async Task<byte[]> ReadAll(IBrowserFile file)
    {
        await using var s = file.OpenReadStream(maxAllowedSize: 512L * 1024 * 1024);
        using var ms = new MemoryStream();
        await s.CopyToAsync(ms);
        return ms.ToArray();
    }

    private static object ModeOf(string path) => Path.GetExtension(path).ToLowerInvariant() switch
    {
        ".html" or ".htm" or ".xhtml" => "htmlmixed",
        ".css" => "css",
        ".js" or ".mjs" => "javascript",
        ".json" => new { name = "javascript", json = true },
        ".xml" or ".xsd" or ".dtd" or ".svg" => "xml",
        _ => "text/plain",
    };

    private static string FormatSize(long n) =>
        n < 1024 ? $"{n} B" : n < 1024 * 1024 ? $"{n / 1024.0:0.0} KB" : $"{n / 1048576.0:0.0} MB";

    /* ---------- file tree ---------- */

    private sealed class Folder
    {
        public SortedDictionary<string, Folder> Folders { get; } = new(StringComparer.Ordinal);
        public List<string> Files { get; } = [];
    }

    private IReadOnlyList<string>? treePaths;
    private Folder? tree;

    // The package returns the same path list until files are added or removed, so the tree is
    // only rebuilt then.
    private Folder TreeFor(IReadOnlyList<string> paths)
    {
        if (!ReferenceEquals(paths, treePaths)) { tree = BuildTree(paths); treePaths = paths; }
        return tree!;
    }

    private static Folder BuildTree(IEnumerable<string> paths)
    {
        var root = new Folder();
        foreach (var p in paths)
        {
            var parts = p.Split('/');
            var node = root;
            foreach (var part in parts[..^1])
            {
                if (!node.Folders.TryGetValue(part, out var next)) node.Folders[part] = next = new Folder();
                node = next;
            }
            node.Files.Add(p);
        }
        return root;
    }

    private RenderFragment RenderFolder(Folder folder, string prefix) => __builder =>
    {
        foreach (var (name, sub) in folder.Folders)
        {
            var full = prefix + name;
            var open = !collapsed.Contains(full);
            <li>
                <div class="se-row" tabindex="0" role="button" @onclick="() => ToggleFolder(full)">
                    <span class="oi @(open ? "oi-folder" : "oi-caret-right") se-icon" aria-hidden="true"></span>
                    <span class="se-name">@name</span>
                </div>
                @if (open)
                {
                    <ul>@RenderFolder(sub, full + "/")</ul>
                }
            </li>
        }
        foreach (var path in folder.Files)
        {
            var ext = Path.GetExtension(path).TrimStart('.').ToLowerInvariant();
            <li>
                <div class="se-row @(path == currentPath ? "current" : null)" tabindex="0" role="button" title="@path" @onclick="() => EditFile(path)">
                    <span class="se-badge se-badge-@KindOf(path)">@(ext.Length == 0 ? "FILE" : ext.Length > 4 ? ext[..4].ToUpperInvariant() : ext.ToUpperInvariant())</span>
                    <span class="se-name">@path.Split('/')[^1]</span>
                    @if (Package!.IsDirty(path))
                    {
                        <span class="se-dot" title="Changed"></span>
                    }
                    @if (ScormPackage.IsHtml(path))
                    {
                        <button type="button" class="se-eye" title="Preview this page" aria-label="Preview @path"
                                @onclick="() => PreviewPage(path)" @onclick:stopPropagation>
                            <span class="oi oi-eye" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            </li>
        }
    };

    private void ToggleFolder(string full)
    {
        if (!collapsed.Remove(full)) collapsed.Add(full);
    }

    private static string KindOf(string path) => Path.GetExtension(path).ToLowerInvariant() switch
    {
        ".html" or ".htm" or ".xhtml" => "html",
        ".css" => "css",
        ".js" or ".mjs" => "js",
        ".xml" or ".xsd" or ".dtd" => "xml",
        _ => "other",
    };

    public async ValueTask DisposeAsync()
    {
        if (Package is not null)
        {
            Package.Changed -= OnPackageChanged;
            Store.Remove(Package.Id);
        }
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        selfRef?.Dispose();
    }
}
