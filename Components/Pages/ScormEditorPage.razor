    /* ---------- review ---------- */

    // One file in the review: the text that will be saved and its diff against what is saved now.
    private sealed record ReviewFile(string Path, string Label, string? NewText, TextDiff.Result? Diff, string? Warning);

    // Skip holds the edits the user unticked; Log is the change log, shown in the package review.
    private sealed record Review(bool Drafts, List<ReviewFile> Files, string? Note, Func<Task>? Then,
        IReadOnlyList<EditMapper.Problem>? Problems = null, EditMapper.Edit[]? Edits = null, HashSet<int>? ChangeAll = null,
        HashSet<int>? Skip = null, IReadOnlyList<ScormPackage.LogEntry>? Log = null);

    // Runs an action that would reload the preview. With unsaved preview edits it opens the
    // review first, and runs the action once they are saved or discarded.
    private async Task AfterDrafts(Func<Task> action)
    {
        if (draftPaths.Length == 0) { await action(); return; }
        await ReviewDrafts(action);
    }

    private async Task ReviewDrafts(Func<Task>? then)
    {
        if (Package is null || module is null) return;
        var edits = await module.InvokeAsync<EditMapper.Edit[]>("getDrafts");
        review = BuildReview(edits, [], [], then);
        StateHasChanged();
    }

    private Review BuildReview(EditMapper.Edit[] edits, HashSet<int> changeAll, HashSet<int> skip, Func<Task>? then)
    {
        var result = EditMapper.Apply(Package!, edits, changeAll, skip);
        var files = result.Files
            .Select(f => new ReviewFile(f.Path, "changed by your edits", f.NewText, TextDiff.Compare(f.OldDisplay, f.NewDisplay),
                f.Notes.Count == 0 ? null : string.Join(" ", f.Notes)))
            .ToList();
        return new Review(true, files,
            then is null ? null : "Save or discard these changes first. The preview reloads afterwards, which would lose them.", then,
            result.Problems, edits, changeAll, skip);
    }

    private void ToggleEdit(int edit)
    {
        if (review is not { Edits: { } edits, ChangeAll: { } all, Skip: { } skip }) return;
        HashSet<int> next = [.. skip];
        if (!next.Remove(edit)) next.Add(edit);
        review = BuildReview(edits, all, next, review.Then);
    }

    private void TickAll(List<int> listed, bool tick)
    {
        if (review is not { Edits: { } edits, ChangeAll: { } all }) return;
        review = BuildReview(edits, all, tick ? [] : [.. listed], review.Then);
    }

    // The user chose to change every copy of a text found in several places.
    private void ChangeAllPlaces(int edit)
    {
        if (review is not { Edits: { } edits, ChangeAll: { } all }) return;
        review = BuildReview(edits, [.. all, edit], review.Skip ?? [], review.Then);
    }

    private void ReviewPackage()
    {
        if (Package is null) return;
        var files = new List<ReviewFile>();
        foreach (var path in Package.ChangedPaths)
        {
            var original = Package.ReadOriginalText(path);
            var exists = Package.Exists(path);
            var label = original is null && !Package.HasOriginal(path) ? "added" : !exists ? "deleted" : "changed";
            if (!ScormPackage.IsText(path))
            {
                files.Add(new ReviewFile(path, label + " (binary file)", null, null, null));
                continue;
            }
            files.Add(new ReviewFile(path, label, null, TextDiff.Compare(original ?? "", exists ? Package.ReadText(path) : ""), null));
        }
        review = new Review(false, files, draftPaths.Length > 0 ? "Unsaved preview edits are not included until you save them." : null, null,
            Log: Package.ChangeLog);
    }

    private async Task SaveDrafts()
    {
        if (Package is null || review is not { Drafts: true } r) return;
        var saved = Enumerable.Range(0, r.Edits?.Length ?? 0)
            .Where(i => r.Skip?.Contains(i) != true && EditMapper.Changes(r.Edits![i]) && r.Problems?.Any(pr => pr.Edit == i) != true)
            .Select(i => (r.Edits![i].Path, EditMapper.Summarize(r.Edits[i])))
            .ToList();
        var label = saved.Count == 1 ? saved[0].Item2 : $"{saved.Count} changes on {string.Join(", ", saved.Select(x => x.Path.Split('/')[^1]).Distinct())}";
        Package.Step(label, r.Files.Select(f => f.Path), () =>
        {
            foreach (var f in r.Files) Package.WriteText(f.Path, f.NewText!);
        }, saved);
        foreach (var f in r.Files) await module!.InvokeVoidAsync("updateDoc", f.Path, f.NewText);
        review = null;
        await module!.InvokeVoidAsync("clearDrafts", r.Then is null);
        draftPaths = [];
        var left = r.Skip?.Count ?? 0;
        Show($"Saved {string.Join(", ", r.Files.Select(f => f.Path))}.{(left > 0 ? $" {left} unticked {(left == 1 ? "change was" : "changes were")} thrown away." : "")} Press Undo to take it back.", "success");
        if (r.Then is not null) await r.Then();
    }

    private async Task DiscardDrafts()
    {
        var then = review?.Then;
        review = null;
        // Always reload so the preview drops the discarded edits.
        await module!.InvokeVoidAsync("clearDrafts", true);
        draftPaths = [];
        Show("Discarded the unsaved preview changes.", "info");
        if (then is not null) await then();
    }

    private void CloseReview() => review = null;

    /* ---------- undo ---------- */

    private Task UndoLast() => AfterDrafts(async () =>
    {
        if (Package is null) return;
        var label = Package.UndoLabel;
        var (refused, paths) = Package.Undo();
        if (refused is not null) { Show(refused, "warning"); return; }
        await SyncEditors(paths);
        Show($"Undid: {label}", "info");
    });

    // After files changed on the server, puts their new text in the code editor and reloads the preview.
    private async Task SyncEditors(IEnumerable<string> paths)
    {
        foreach (var path in paths)
        {
            if (Package!.Exists(path) && ScormPackage.IsText(path)) await module!.InvokeVoidAsync("updateDoc", path, Package.ReadText(path));
            else await module!.InvokeVoidAsync("forget", path);
        }
        if (currentPath is not null && !Package!.Exists(currentPath)) currentPath = null;
        await module!.InvokeVoidAsync("reloadPreview");
    }

    /* ---------- find and replace ---------- */

    private sealed class FindState
    {
        public string Text { get; set; } = "";
        public string Replace { get; set; } = "";
        public bool MatchCase { get; set; }
        public bool WholeWord { get; set; }
        public IReadOnlyList<EditMapper.Hit>? Hits { get; set; }
        public HashSet<int> Skip { get; set; } = [];
        public string Searched { get; set; } = "";
        public string SearchedReplace { get; set; } = "";
        public (bool, bool) SearchedOptions { get; set; }

        // The list shows an earlier search; replacing would use different words.
        public bool Stale => Text != Searched || Replace != SearchedReplace || (MatchCase, WholeWord) != SearchedOptions;
    }

    private FindState? find;

    /* ---------- word check ---------- */

    private sealed record TermPrefs(string Text, bool MatchCase, bool WholeWord, bool Chips, bool HideMissing);

    private sealed class TermState
    {
        public const int MaxHits = 5000;
        public static readonly string[] Colours = ["#ffe14d", "#8be9a8", "#9ad0ff", "#ffb3c7", "#ffc98a", "#c9b6ff", "#7ff0e6", "#e6f58a", "#ffd6a5", "#b5ead7"];
        public string Text { get; set; } = TermList.Default;
        public bool MatchCase { get; set; } = true;
        public bool WholeWord { get; set; } = true;
        public bool Chips { get; set; }
        public bool HideMissing { get; set; } = true;
        public IReadOnlyList<TermList.Term> Terms { get; set; } = [];
        public IReadOnlyList<EditMapper.TermHit> Hits { get; set; } = [];
        public int[] Counts { get; set; } = [];
        public int[] PageCounts { get; set; } = [];
        public int[] PageHidden { get; set; } = [];
        public int Frames { get; set; }
        public string[] Blocked { get; set; } = [];
        public Dictionary<int, string> Position { get; } = [];
        public int? Open { get; set; }
        public bool Editing { get; set; }
        public string Draft { get; set; } = "";
        public bool DraftCase { get; set; }
        public bool DraftWhole { get; set; }
        public int CourseCount(int i) => i < Counts.Length ? Counts[i] : 0;
    }

    /// <summary>What the preview found on the page shown, sent by JS after each scan.</summary>
    public sealed record TermsOnPage(int[] Counts, int[] Hidden, int Frames, string[] Blocked);

    private TermState? terms;
    private bool termsOpen;

    private void LoadTermPrefs(string? json)
    {
        terms = new TermState();
        try
        {
            if (json is { Length: > 0 } && System.Text.Json.JsonSerializer.Deserialize<TermPrefs>(json) is { } p)
            {
                terms.Text = p.Text;
                terms.MatchCase = p.MatchCase;
                terms.WholeWord = p.WholeWord;
                terms.Chips = p.Chips;
                terms.HideMissing = p.HideMissing;
            }
        }
        catch (System.Text.Json.JsonException) { }
        terms.Terms = TermList.Parse(terms.Text, terms.MatchCase);
    }

    private async Task SaveTermPrefs()
    {
        if (terms is null || module is null) return;
        var prefs = new TermPrefs(terms.Text, terms.MatchCase, terms.WholeWord, terms.Chips, terms.HideMissing);
        await module.InvokeVoidAsync("setPref", "terms", System.Text.Json.JsonSerializer.Serialize(prefs));
    }

    private async Task ToggleTerms()
    {
        terms ??= new TermState { Terms = TermList.Parse(TermList.Default, true) };
        termsOpen = !termsOpen;
        if (termsOpen)
        {
            ScanCourseTerms();
            await SendTerms();
        }
        else
        {
            terms.Position.Clear();
            await TryJs("setTerms", (object?)null);
        }
    }

    // The whole course, on the server: every page and the data Rise and Storyline build pages from.
    private void ScanCourseTerms()
    {
        if (terms is null || Package is null) return;
        try
        {
            terms.Hits = EditMapper.ScanTerms(Package, terms.Terms.Select(t => t.Old).ToList(), terms.MatchCase, terms.WholeWord, TermState.MaxHits);
        }
        catch (Exception ex) when (ex is System.Text.RegularExpressions.RegexMatchTimeoutException or ArgumentException or InvalidOperationException or IndexOutOfRangeException)
        {
            // A failed scan must never close the editor: show what happened and keep going.
            terms.Hits = [];
            Show($"The word check couldn't read the whole course ({ex.GetType().Name}: {ex.Message}). Counts on the page still work.", "warning");
        }
        var counts = new int[terms.Terms.Count];
        foreach (var hit in terms.Hits) counts[hit.Term]++;
        terms.Counts = counts;
    }

    // The page in the preview, in the browser: highlights, tips and counts for this page.
    private async Task SendTerms()
    {
        if (terms is null || module is null) return;
        terms.Position.Clear();
        await TryJs("setTerms", new
        {
            words = terms.Terms.Select(t => new[] { t.Old, t.New }).ToArray(),
            cs = terms.MatchCase,
            whole = terms.WholeWord,
            chips = terms.Chips,
        });
    }

    // Word check calls into the preview: a script error in an unusual course page is reported, not
    // allowed to close the editor.
    private async Task TryJs(string name, params object?[] args)
    {
        try { await module!.InvokeVoidAsync(name, args); }
        catch (JSException ex) { Show($"The word check hit a problem in this page: {ex.Message}", "warning"); }
    }

    [JSInvokable]
    public Task OnTermsOnPage(TermsOnPage result) => InvokeAsync(() =>
    {
        if (terms is null) return;
        terms.PageCounts = result.Counts;
        terms.PageHidden = result.Hidden;
        terms.Frames = result.Frames;
        terms.Blocked = result.Blocked;
        terms.Position.Clear();
        StateHasChanged();
    });

    private async Task TermGo(int index, int dir)
    {
        if (terms is null) return;
        TermPosition? at;
        try { at = await module!.InvokeAsync<TermPosition?>("termsGo", index, dir); }
        catch (JSException ex) { Show($"The word check hit a problem in this page: {ex.Message}", "warning"); return; }
        if (at is null) return;
        terms.Position[index] = Describe(at);
    }

    public sealed record TermPosition(int At, int Of, bool Hidden);

    private static string Describe(TermPosition at) =>
        $"{at.At} of {at.Of} on this page{(at.Hidden ? " (hidden: on another tab or slide)" : "")}";

    // Clicking a word: its next match when the page shows it; otherwise the page (and Rise lesson)
    // with its first place in the course, scrolled to the word once it is drawn.
    private Task ShowTerm(int index, EditMapper.TermHit? place = null) => AfterDrafts(async () =>
    {
        if (terms is null || Package is null) return;
        if (tab != Tab.Preview) ShowTab(Tab.Preview);
        var onPage = index < terms.PageCounts.Length ? terms.PageCounts[index] : 0;
        if (place is null && onPage > 0)
        {
            await TermGo(index, 1);
            return;
        }
        place ??= terms.Hits.Where(h => h.Term == index && ScormPackage.IsHtml(h.Path)).OrderBy(h => h.Anchor is null).FirstOrDefault();
        if (place is null)
        {
            Show($"“{terms.Terms[index].Old}” is only in a data file that the preview can't open on its own. Its places are listed under the count.", "info");
            return;
        }
        try
        {
            if (!await module!.InvokeAsync<bool>("termsShow", place.Path, place.Anchor, index))
            {
                previewPath = place.Path;
                Package.LastPreviewPath = place.Path;
                await module!.InvokeVoidAsync("loadPreviewAt", place.Path, place.Anchor);
            }
        }
        catch (JSException ex) { Show($"The word check hit a problem in this page: {ex.Message}", "warning"); }
    });

    [JSInvokable]
    public Task OnTermShown(int index, TermPosition at) => InvokeAsync(() =>
    {
        if (terms is null) return;
        terms.Position[index] = Describe(at);
        StateHasChanged();
    });

    private void ToggleTermEditor()
    {
        if (terms is null) return;
        terms.Editing = !terms.Editing;
        terms.Draft = terms.Text;
        terms.DraftCase = terms.MatchCase;
        terms.DraftWhole = terms.WholeWord;
    }

    private async Task SaveTermList()
    {
        if (terms is null) return;
        terms.Text = terms.Draft.Replace("\r\n", "\n");
        terms.MatchCase = terms.DraftCase;
        terms.WholeWord = terms.DraftWhole;
        terms.Terms = TermList.Parse(terms.Text, terms.MatchCase);
        terms.Editing = false;
        terms.Open = null;
        await SaveTermPrefs();
        ScanCourseTerms();
        await SendTerms();
        Show($"Checking {terms.Terms.Count} words.", "info");
    }

    private async Task ToggleTermChips(ChangeEventArgs e)
    {
        if (terms is null) return;
        terms.Chips = e.Value is true;
        await SaveTermPrefs();
        await SendTerms();
    }

    private async Task CopyTermReport()
    {
        if (terms is null || Package is null) return;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Word check report");
        sb.AppendLine($"Course: {Package.FileName}");
        sb.AppendLine($"Places in the course: {terms.Hits.Count} | Words found: {terms.Terms.Where((_, i) => terms.CourseCount(i) > 0).Count()} of {terms.Terms.Count}");
        sb.AppendLine();
        sb.AppendLine("Old word\tNew word\tIn the course\tOn this page");
        for (var i = 0; i < terms.Terms.Count; i++)
            sb.AppendLine($"{terms.Terms[i].Old}\t{terms.Terms[i].New}\t{terms.CourseCount(i)}\t{(i < terms.PageCounts.Length ? terms.PageCounts[i] : 0)}");
        var places = terms.Hits.Take(1000).ToList();
        if (places.Count > 0)
        {
            sb.AppendLine();
            sb.AppendLine("Where");
            foreach (var hit in places)
                sb.AppendLine($"{terms.Terms[hit.Term].Old}\t{hit.Path}\t…{hit.Before}[{hit.Text}]{hit.After}…");
        }
        await TryJs("copyText", sb.ToString());
        Show("Copied the word check report. Paste it into an email or a spreadsheet.", "success");
    }

    private Task OpenFind() => AfterDrafts(() =>
    {
        find ??= new FindState();
        return Task.CompletedTask;
    });

    private void RunFind()
    {
        if (Package is null || find is null || find.Text.Trim().Length == 0) return;
        find.Hits = EditMapper.FindReplace(Package, find.Text, find.Replace, find.MatchCase, find.WholeWord).Hits;
        find.Skip = [];
        find.Searched = find.Text;
        find.SearchedReplace = find.Replace;
        find.SearchedOptions = (find.MatchCase, find.WholeWord);
    }

    private void ToggleHit(int index)
    {
        if (find is not null && !find.Skip.Remove(index)) find.Skip.Add(index);
    }

    private void TickAllHits(bool tick)
    {
        if (find?.Hits is { } hits) find.Skip = tick ? [] : [.. hits.Select(h => h.Index)];
    }

    private async Task ApplyReplace()
    {
        if (Package is null || find is not { Hits.Count: > 0, Stale: false }) return;
        var (result, hits) = EditMapper.FindReplace(Package, find.Searched, find.SearchedReplace, find.MatchCase, find.WholeWord, find.Skip);
        var count = hits.Count - find.Skip.Count;
        if (result.Files.Count == 0) { Show("Nothing was replaced.", "info"); return; }
        var label = $"Replaced “{find.Searched}” with “{find.SearchedReplace}” in {count} {(count == 1 ? "place" : "places")}";
        Package.Step(label, result.Files.Select(f => f.Path), () =>
        {
            foreach (var f in result.Files) Package.WriteText(f.Path, f.NewText);
        }, result.Files.Select(f => (f.Path, $"Replaced “{find.Searched}” with “{find.SearchedReplace}” ({hits.Count(h => h.Path == f.Path && !find.Skip.Contains(h.Index))}×)")));
        await SyncEditors(result.Files.Select(f => f.Path));
        find = null;
        Show(label + ". Press Undo to take it back.", "success");
    }

    private async Task Reindent() => await module!.InvokeVoidAsync("reindent");

    private async Task RevertFile()
    {
        if (Package is null || currentPath is null) return;
        var path = currentPath;
        Package.Step($"Reverted {path}", [path], () => Package.Revert(path), [(path, "Put back as it was in the opened course")]);
        if (ScormPackage.IsText(currentPath))
            await module!.InvokeVoidAsync("openText", currentPath, Package.ReadText(currentPath), ModeOf(currentPath), true);
        await module!.InvokeVoidAsync("reloadPreview");
        Show($"Reverted {currentPath} to the version in the opened package.", "info");
    }

    private async Task AddFile()
    {
        if (Package is null) return;
        var path = ScormPackage.Normalize(newPath ?? "");
        if (path.Length == 0) return;
        if (Package.Exists(path)) { Show($"{path} already exists.", "warning"); return; }
        var text = ScormPackage.IsHtml(path)
            ? "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>New page</title>\n</head>\n<body>\n  <h1>New page</h1>\n</body>\n</html>\n"
            : "";
        Package.Step($"Added {path}", [path], () => Package.WriteText(path, text), [(path, "Added")]);
        newPath = null;
        await EditFile(path);
    }

    private async Task UploadFiles(InputFileChangeEventArgs e)
    {
        if (Package is null) return;
        var dir = currentPath is null ? "" : ScormPackage.DirOf(currentPath);
        var uploads = new List<(string Path, byte[] Data)>();
        foreach (var file in e.GetMultipleFiles(500))
            uploads.Add((ScormPackage.Normalize($"{dir}/{file.Name}"), await ReadAll(file)));
        var count = uploads.Count;
        Package.Step($"Added {count} file{(count == 1 ? "" : "s")}", uploads.Select(u => u.Path), () =>
        {
            foreach (var (path, data) in uploads) Package.Write(path, data);
        }, uploads.Select(u => (u.Path, "Added or replaced")));
        foreach (var (path, _) in uploads) await module!.InvokeVoidAsync("forget", path);
        await module!.InvokeVoidAsync("reloadPreview");
        Show($"Added {count} file{(count == 1 ? "" : "s")} to {(dir.Length == 0 ? "the package root" : dir)}.", "success");
    }

    private async Task ReplaceFile(InputFileChangeEventArgs e)
    {
        if (Package is null || currentPath is null) return;
        var path = currentPath;
        var data = await ReadAll(e.File);
        Package.Step($"Replaced {path}", [path], () => Package.Write(path, data), [(path, $"Replaced with {e.File.Name}")]);
        await module!.InvokeVoidAsync("reloadPreview");
        Show($"Replaced {currentPath}.", "success");
    }

    private async Task RenameFile()
    {
        if (Package is null || currentPath is null) return;
        var to = ScormPackage.Normalize(renamePath ?? "");
        if (to.Length == 0 || to == currentPath) return;
        if (Package.Exists(to)) { Show($"{to} already exists.", "warning"); return; }
        var from = currentPath;
        Package.Step($"Renamed {from}", [from, to], () => Package.Rename(from, to), [(to, $"Renamed from {from}")]);
        await module!.InvokeVoidAsync("forget", from);
        if (previewPath == from) await SetPreview(to);
        await OpenFile(to);
        Show($"Renamed {from} to {to}. Links to the old name are not updated.", "info");
    }

    private async Task DeleteFile()
    {
        if (Package is null || currentPath is null) return;
        if (!confirmDelete) { confirmDelete = true; return; }
        var path = currentPath;
        Package.Step($"Deleted {path}", [path], () => Package.Delete(path), [(path, "Deleted")]);
        await module!.InvokeVoidAsync("forget", path);
        currentPath = null;
        confirmDelete = false;
        if (previewPath == path) await SetPreview(Package.Manifest?.LaunchPath);
        Show($"Deleted {path}.", "info");
    }

    private async Task SyncManifest()
    {
        if (Package is null) return;
        int? count = null;
        Package.Step("Updated the manifest's file list", [Package.ManifestPath], () => count = Package.SyncManifestFileList(),
            [(Package.ManifestPath, "Updated the list of files")]);
        if (count is null) { Show("Open a package with a valid imsmanifest.xml and at least one resource first.", "warning"); return; }
        if (currentPath == Package.ManifestPath)
            await module!.InvokeVoidAsync("openText", currentPath, Package.ReadText(currentPath), ModeOf(currentPath), true);
        else
            await module!.InvokeVoidAsync("forget", Package.ManifestPath);
        Show($"imsmanifest.xml now lists {count} files in the launch resource.", "success");
    }

    private void ShowTab(Tab next)
    {
        if (tab == next) return;
        tab = next;
        _ = module?.InvokeVoidAsync("setPreviewVisible", next == Tab.Preview).AsTask();
        // CodeMirror cannot measure itself while hidden, so it is refreshed once the Code tab is visible.
        if (next == Tab.Code) refreshEditor = true;
    }

    private void Show(string message, string kind)
    {
        status = message;
        statusKind = kind;
        StateHasChanged();
    }

    private string PreviewUrl(string path) =>
        $"scorm-preview/{Package!.Id}/{string.Join('/', path.Split('/').Select(Uri.EscapeDataString))}";

    private static async Task<byte[]> ReadAll(IBrowserFile file)
    {
        await using var s = file.OpenReadStream(maxAllowedSize: 512L * 1024 * 1024);
        using var ms = new MemoryStream();
        await s.CopyToAsync(ms);
        return ms.ToArray();
    }

    private static object ModeOf(string path) => Path.GetExtension(path).ToLowerInvariant() switch
    {
        ".html" or ".htm" or ".xhtml" => "htmlmixed",
        ".css" => "css",
        ".js" or ".mjs" => "javascript",
        ".json" => new { name = "javascript", json = true },
        ".xml" or ".xsd" or ".dtd" or ".svg" => "xml",
        _ => "text/plain",
    };

    private static string FormatSize(long n) =>
        n < 1024 ? $"{n} B" : n < 1024 * 1024 ? $"{n / 1024.0:0.0} KB" : $"{n / 1048576.0:0.0} MB";

    /* ---------- file tree ---------- */

    private sealed class Folder
    {
        public SortedDictionary<string, Folder> Folders { get; } = new(StringComparer.Ordinal);
        public List<string> Files { get; } = [];
    }

    private IReadOnlyList<string>? treePaths;
    private Folder? tree;

    // The package returns the same path list until files are added or removed, so the tree is
    // only rebuilt then.
    private Folder TreeFor(IReadOnlyList<string> paths)
    {
        if (!ReferenceEquals(paths, treePaths)) { tree = BuildTree(paths); treePaths = paths; }
        return tree!;
    }

    private static Folder BuildTree(IEnumerable<string> paths)
    {
        var root = new Folder();
        foreach (var p in paths)
        {
            var parts = p.Split('/');
            var node = root;
            foreach (var part in parts[..^1])
            {
                if (!node.Folders.TryGetValue(part, out var next)) node.Folders[part] = next = new Folder();
                node = next;
            }
            node.Files.Add(p);
        }
        return root;
    }

    private RenderFragment RenderFolder(Folder folder, string prefix) => __builder =>
    {
        foreach (var (name, sub) in folder.Folders)
        {
            var full = prefix + name;
            var open = !collapsed.Contains(full);
            <li>
                <div class="se-row" tabindex="0" role="button" @onclick="() => ToggleFolder(full)">
                    <span class="oi @(open ? "oi-folder" : "oi-caret-right") se-icon" aria-hidden="true"></span>
                    <span class="se-name">@name</span>
                </div>
                @if (open)
                {
                    <ul>@RenderFolder(sub, full + "/")</ul>
                }
            </li>
        }
        foreach (var path in folder.Files)
        {
            var ext = Path.GetExtension(path).TrimStart('.').ToLowerInvariant();
            <li>
                <div class="se-row @(path == currentPath ? "current" : null)" tabindex="0" role="button" title="@path" @onclick="() => EditFile(path)">
                    <span class="se-badge se-badge-@KindOf(path)">@(ext.Length == 0 ? "FILE" : ext.Length > 4 ? ext[..4].ToUpperInvariant() : ext.ToUpperInvariant())</span>
                    <span class="se-name">@path.Split('/')[^1]</span>
                    @if (Package!.IsDirty(path))
                    {
                        <span class="se-dot" title="Changed"></span>
                    }
                    @if (ScormPackage.IsHtml(path))
                    {
                        <button type="button" class="se-eye" title="Preview this page" aria-label="Preview @path"
                                @onclick="() => PreviewPage(path)" @onclick:stopPropagation>
                            <span class="oi oi-eye" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            </li>
        }
    };

    private void ToggleFolder(string full)
    {
        if (!collapsed.Remove(full)) collapsed.Add(full);
    }

    private static string KindOf(string path) => Path.GetExtension(path).ToLowerInvariant() switch
    {
        ".html" or ".htm" or ".xhtml" => "html",
        ".css" => "css",
        ".js" or ".mjs" => "js",
        ".xml" or ".xsd" or ".dtd" => "xml",
        _ => "other",
    };

    public async ValueTask DisposeAsync()
    {
        if (Package is not null)
        {
            Package.Changed -= OnPackageChanged;
            Package.Expired -= OnPackageExpired;
            // Kept for a while so a refresh, or coming back from another page, carries on with it.
            Store.Release(Package);
        }
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        selfRef?.Dispose();
    }
}
