@page "/editor"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ScormPackageStore Store
@inject AssetVersion Assets

<PageTitle>SCORM Editor</PageTitle>

<div class="scorm-editor @(advanced ? "advanced" : "simple")">
    @* Dropping a course .zip anywhere on the editor opens it: while a file is dragged over the page
       this invisible file input covers it and receives the drop. *@
    <label class="se-drop" aria-hidden="true">
        <span class="se-drop-hint"><span class="oi oi-data-transfer-upload" aria-hidden="true"></span> Drop the course .zip to open it</span>
        <InputFile OnChange="OpenZip" accept=".zip,application/zip" class="se-drop-input" tabindex="-1" />
    </label>

    <div class="se-toolbar">
        <div class="se-title">
            <h3 class="mb-0">@(Package?.Manifest?.CourseTitle is { Length: > 0 } t ? t : "SCORM Editor")</h3>
            @if (Package is not null)
            {
                <span class="text-muted small text-truncate" title="@Package.FileName">@Package.FileName</span>
                @if (advanced)
                {
                    <span class="badge text-bg-primary">@(Package.Manifest?.Version ?? "No manifest")</span>
                }
                @if (Package.ChangeCount > 0)
                {
                    <button type="button" class="badge text-bg-warning border-0" title="See the change log and every change since the course was opened" @onclick="ReviewPackage">
                        @Package.ChangeCount @(Package.ChangeCount == 1 ? "changed file" : "changed files")
                    </button>
                }
            }
        </div>
        <div class="se-actions">
            <label class="btn btn-sm btn-outline-primary mb-0 @(loading ? "disabled" : "")">
                <span class="oi oi-folder me-1" aria-hidden="true"></span>@(loading ? "Opening…" : "Open course…")
                <InputFile OnChange="OpenZip" accept=".zip,application/zip" class="d-none" />
            </label>
            @if (Package is not null)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenFind" title="Find text anywhere in the course and replace it">
                    <span class="oi oi-magnifying-glass me-1" aria-hidden="true"></span>Find and replace
                </button>
                <button type="button" class="btn btn-sm @(termsOpen ? "btn-secondary" : "btn-outline-secondary")" @onclick="ToggleTerms" aria-pressed="@termsOpen"
                        title="Point out words from your word list that should be replaced. Nothing is changed for you.">
                    <span class="oi oi-spreadsheet me-1" aria-hidden="true"></span>Word check
                </button>
                @if (Package.UndoLabel is { } undoLabel)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="UndoLast" title="Undo: @undoLabel">
                        <span class="oi oi-action-undo me-1" aria-hidden="true"></span>Undo
                    </button>
                }
                @if (Package.ChangeCount > 0)
                {
                    <button type="button" class="btn btn-sm @(confirmStartOver ? "btn-danger" : "btn-outline-danger")" @onclick="StartOver"
                            title="Undo every change and go back to the course as it was when you opened it">
                        <span class="oi oi-reload me-1" aria-hidden="true"></span>@(confirmStartOver ? "Click again to undo everything" : "Start over")
                    </button>
                }
                <button type="button" class="btn btn-sm btn-primary" @onclick="Export" title="Download the edited course as a .zip to upload to your LMS">
                    <span class="oi oi-data-transfer-download me-1" aria-hidden="true"></span>Download course
                </button>
            }
            <div class="form-check form-switch mb-0 small ms-1 align-self-center" title="Show the file list, code editor, manifest tools and LMS test panel">
                <input class="form-check-input" type="checkbox" id="se-advanced" checked="@advanced" @onchange="ToggleAdvanced" />
                <label class="form-check-label" for="se-advanced">Advanced</label>
            </div>
        </div>
    </div>

    @if (showTips && Package is not null)
    {
        <ol class="se-tips" aria-label="How to edit">
            <li><span class="se-step">1</span>Click any text in the page and type.</li>
            <li><span class="se-step">2</span>Right-click a link, button, video or image to change it. Ctrl+click to go to another page.</li>
            <li><span class="se-step">3</span>Press <strong>Review and save</strong> to check your changes.</li>
            <li><span class="se-step">4</span>Press <strong>Download course</strong> and upload it to your LMS.</li>
            <li class="ms-auto"><button type="button" class="btn btn-sm btn-link p-0" @onclick="HideTips">Hide tips</button></li>
        </ol>
    }

    @if (status is not null)
    {
        <div class="alert alert-@statusKind alert-dismissible py-2 mb-2 small" role="status">
            @status
            <button type="button" class="btn-close py-2" aria-label="Dismiss" @onclick="() => status = null"></button>
        </div>
    }

    @if (Package is null)
    {
        @* Start screen. The editor below stays in the page (hidden) because the preview frame and
           code editor are set up once when the page loads. *@
        <div class="se-start">
            <span class="oi oi-data-transfer-upload se-start-icon" aria-hidden="true"></span>
            <h4>Open a SCORM course to edit it</h4>
            <p class="text-muted mb-3">Choose the course .zip exported from your authoring tool, or drag it onto this page.</p>
            <label class="btn btn-primary @(loading ? "disabled" : "")">
                <span class="oi oi-folder me-1" aria-hidden="true"></span>@(loading ? "Opening…" : "Choose a course .zip")
                <InputFile OnChange="OpenZip" accept=".zip,application/zip" class="d-none" />
            </label>
            <p class="small text-muted mt-3 mb-0">Your changes are kept only while this tab is open. Press Download course to keep them.</p>
        </div>
    }

    <div class="se-grid @(sideOpen ? null : "side-closed") @(termsOpen ? "terms-open" : null)" hidden="@(Package is null)">
        @* Package: course structure, manifest facts and the file tree. It folds into a thin rail to
           give the editor the full width. *@
        @if (!sideOpen)
        {
            <nav class="se-pane se-rail" aria-label="Package">
                <button type="button" class="btn btn-sm btn-link" title="Show course structure and files" aria-label="Show course structure and files" @onclick="ToggleSide">
                    <span class="oi oi-chevron-right" aria-hidden="true"></span>
                </button>
                <span class="se-rail-label">Course structure</span>
            </nav>
        }
        <section class="se-pane se-side" aria-label="Package" hidden="@(!sideOpen)">
            <div class="se-pane-header">
                <span class="flex-grow-1">@(advanced ? "Course structure" : "Course pages")</span>
                <button type="button" class="btn btn-sm btn-link p-0" title="Hide this pane to make the editor wider" aria-label="Hide course structure" @onclick="ToggleSide">
                    <span class="oi oi-chevron-left" aria-hidden="true"></span>
                </button>
            </div>
            <div class="se-pane-body">
                @if (Package?.Manifest is null || (!advanced && Package.Manifest.Error is not null))
                {
                    @if (Package is null)
                    {
                        <p class="small text-muted px-2 mb-2">Open a course to begin.</p>
                    }
                    else if (!advanced)
                    {
                        @* Without a readable manifest, list the package's pages instead. *@
                        <ol class="se-org">
                            @foreach (var (pg, i) in Package.Paths.Where(ScormPackage.IsHtml).Select((p, i) => (p, i)))
                            {
                                <li>
                                    <button type="button" class="@(pg == previewPath ? "current" : null)" title="@pg" @onclick="() => PreviewPage(pg)">
                                        <span class="se-ix">@(i + 1)</span><span>@pg</span>
                                    </button>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="small text-muted px-2 mb-2">No imsmanifest.xml in this package.</p>
                    }
                }
                else if (Package.Manifest.Error is not null)
                {
                    <p class="small text-danger px-2 mb-2">imsmanifest.xml has an XML error. @Package.Manifest.Error</p>
                }
                else
                {
                    <ol class="se-org">
                        @foreach (var (item, i) in Package.Manifest.Items.Select((it, i) => (it, i)))
                        {
                            <li>
                                <button type="button" class="@(item.Path is not null && item.Path == previewPath ? "current" : null)"
                                        style="padding-left: @(6 + item.Depth * 14)px" disabled="@(item.Path is null)"
                                        title="@(item.Path is null && item.Href is not null ? $"Missing file: {item.Href}" : item.Path)"
                                        @onclick="() => OpenItem(item)">
                                    <span class="se-ix">@(i + 1)</span><span>@item.Title</span>
                                </button>
                            </li>
                        }
                    </ol>
                    @if (advanced)
                    {
                        <dl class="se-meta">
                            <dt>Launch</dt><dd>@(Package.Manifest.LaunchPath ?? "—")</dd>
                            <dt>Identifier</dt><dd>@Package.Manifest.Identifier</dd>
                            <dt>Resources</dt><dd>@Package.Manifest.Resources.Count</dd>
                        </dl>
                    }
                }

                @if (advanced)
                {
                    <div class="se-section-label">
                        <span>Files</span>
                        @if (Package is not null) { <span>@Package.Paths.Count</span> }
                    </div>
                    @if (Package is not null)
                    {
                        <ul class="se-tree">@RenderFolder(TreeFor(Package.Paths), "")</ul>
                    }
                }
            </div>
            @if (Package is not null && advanced)
            {
                <div class="se-side-footer">
                    <form class="input-group input-group-sm" @onsubmit="AddFile" @onsubmit:preventDefault>
                        <input class="form-control" placeholder="folder/new-page.html" aria-label="New file path" @bind="newPath" />
                        <button class="btn btn-outline-secondary" type="submit">Add</button>
                    </form>
                    <div class="d-flex gap-1 flex-wrap">
                        <label class="btn btn-sm btn-outline-secondary mb-0" title="Add files to the folder of the selected file">
                            <span class="oi oi-cloud-upload me-1" aria-hidden="true"></span>Upload
                            <InputFile OnChange="UploadFiles" multiple class="d-none" />
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SyncManifest"
                                title="List every package file in the launch resource of imsmanifest.xml">
                            <span class="oi oi-list me-1" aria-hidden="true"></span>Sync manifest
                        </button>
                    </div>
                    @if (currentPath is not null)
                    {
                        <div class="input-group input-group-sm">
                            <input class="form-control" aria-label="Rename selected file" @bind="renamePath" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="RenameFile">Rename</button>
                            <button class="btn btn-outline-danger" type="button" @onclick="DeleteFile">@(confirmDelete ? "Confirm" : "Delete")</button>
                        </div>
                    }
                </div>
            }
        </section>

        @* Main work area: Preview and Code tabs. Both panels stay in the DOM so the course keeps its
           state and CodeMirror keeps its undo history while the other tab is showing. *@
        <section class="se-pane se-main" aria-label="Editor">
            <div class="se-tabs" role="tablist">
                <button type="button" role="tab" class="se-tab @(tab == Tab.Preview ? "active" : null)" aria-selected="@(tab == Tab.Preview)" @onclick="() => ShowTab(Tab.Preview)">
                    <span class="oi oi-eye me-1" aria-hidden="true"></span>Preview
                    @if (previewPath is not null) { <span class="se-tab-file">@previewPath.Split('/')[^1]</span> }
                </button>
                <button type="button" role="tab" class="se-tab @(tab == Tab.Code ? "active" : null)" aria-selected="@(tab == Tab.Code)" @onclick="() => ShowTab(Tab.Code)" hidden="@(!advanced)">
                    <span class="oi oi-code me-1" aria-hidden="true"></span>Code
                    @if (currentPath is not null)
                    {
                        <span class="se-tab-file">@currentPath.Split('/')[^1]</span>
                        @if (Package?.IsDirty(currentPath) == true) { <span class="se-dot" title="Changed"></span> }
                    }
                </button>
                <div class="se-tab-tools">
                    @if (tab == Tab.Code)
                    {
                        <span class="se-path text-truncate">@(currentPath ?? "—")</span>
                        <button type="button" class="btn btn-sm btn-link" @onclick="Reindent" disabled="@(currentPath is null || !ScormPackage.IsText(currentPath))">Re-indent</button>
                        <button type="button" class="btn btn-sm btn-link" @onclick="RevertFile"
                                disabled="@(currentPath is null || Package is null || !Package.HasOriginal(currentPath) || !Package.IsDirty(currentPath))">Revert file</button>
                    }
                </div>
            </div>

            <div class="se-panel" role="tabpanel" aria-label="Preview" hidden="@(tab != Tab.Preview)">
                <div class="se-preview-tools">
                <select class="form-select form-select-sm se-addr" aria-label="Page to preview" value="@previewPath" @onchange="e => PickPreview(e.Value?.ToString())">
                    @if (Package is not null)
                    {
                        @foreach (var p in Package.Paths.Where(ScormPackage.IsHtml))
                        {
                            <option value="@p">@p@(p == Package.Manifest?.LaunchPath ? "  (launch)" : "")</option>
                        }
                    }
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Reload preview" @onclick="ReloadPreview"><span class="oi oi-reload"></span></button>
                <div class="btn-group btn-group-sm" role="group" aria-label="Preview width">
                    @foreach (var (label, w) in Widths)
                    {
                        <button type="button" class="btn @(frameWidth == w ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => frameWidth = w">@label</button>
                    }
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Preview mode">
                    <button type="button" class="btn @(previewMode == PreviewMode.Edit ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetMode(PreviewMode.Edit)"
                            title="Click any text in the page and type; right-click links, embeds and images to edit them">
                        <span class="oi oi-pencil me-1" aria-hidden="true"></span>Edit
                    </button>
                    <button type="button" class="btn @(previewMode == PreviewMode.Interact ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetMode(PreviewMode.Interact)"
                            title="Use the course as a learner: links, buttons and quizzes work">
                        <span class="oi oi-media-play me-1" aria-hidden="true"></span>@(advanced ? "Interact" : "Try it")
                    </button>
                </div>
                @if (advanced)
                {
                    <div class="form-check form-switch mb-0 small">
                        <input class="form-check-input" type="checkbox" id="se-live" checked="@live" @onchange="ToggleLive" />
                        <label class="form-check-label" for="se-live">Live</label>
                    </div>
                }
                </div>
            @if (previewMode == PreviewMode.Edit)
            {
                <div class="se-editbar">
                    @* Formatting acts on the selected text (or, with nothing selected, the paragraph the cursor is in).
                       Every change is a draft like typing: it is saved only through Review and save. *@
                    <select class="form-select form-select-sm se-fmt-block" title="Paragraph style" aria-label="Paragraph style"
                            @onchange='e => Exec("formatBlock", e.Value?.ToString())' value="">
                        <option value="" disabled>Style</option>
                        <option value="p">Normal text</option>
                        <option value="h1">Heading 1</option>
                        <option value="h2">Heading 2</option>
                        <option value="h3">Heading 3</option>
                        <option value="h4">Heading 4</option>
                        <option value="blockquote">Quote</option>
                    </select>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Text">
                        <button type="button" class="btn btn-light" title="Bold (Ctrl+B)" @onclick='() => Exec("bold")' @onmousedown:preventDefault><b>B</b></button>
                        <button type="button" class="btn btn-light" title="Italic (Ctrl+I)" @onclick='() => Exec("italic")' @onmousedown:preventDefault><i>I</i></button>
                        <button type="button" class="btn btn-light" title="Underline (Ctrl+U)" @onclick='() => Exec("underline")' @onmousedown:preventDefault><u>U</u></button>
                        <button type="button" class="btn btn-light" title="Strikethrough" @onclick='() => Exec("strikeThrough")' @onmousedown:preventDefault><s>S</s></button>
                        <button type="button" class="btn btn-light" title="Superscript" @onclick='() => Exec("superscript")' @onmousedown:preventDefault>x<sup>2</sup></button>
                        <button type="button" class="btn btn-light" title="Subscript" @onclick='() => Exec("subscript")' @onmousedown:preventDefault>x<sub>2</sub></button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Size and colour">
                        <button type="button" class="btn btn-light" title="Smaller text" @onclick='() => Exec("fontSmaller")' @onmousedown:preventDefault><span class="se-fmt-a small">A</span>−</button>
                        <button type="button" class="btn btn-light" title="Larger text" @onclick='() => Exec("fontBigger")' @onmousedown:preventDefault><span class="se-fmt-a">A</span>+</button>
                        <label class="btn btn-light se-fmt-colour" title="Text colour" @onmousedown:preventDefault>
                            <span class="se-fmt-a" style="border-bottom-color:@textColour">A</span>
                            <input type="color" value="@textColour" aria-label="Text colour" @onchange='e => SetColour("foreColor", e.Value?.ToString())' />
                        </label>
                        <label class="btn btn-light se-fmt-colour" title="Highlight colour" @onmousedown:preventDefault>
                            <span class="oi oi-brush" style="border-bottom:3px solid @markColour"></span>
                            <input type="color" value="@markColour" aria-label="Highlight colour" @onchange='e => SetColour("hiliteColor", e.Value?.ToString())' />
                        </label>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Alignment">
                        <button type="button" class="btn btn-light" title="Align left" @onclick='() => Exec("justifyLeft")' @onmousedown:preventDefault><span class="oi oi-align-left"></span></button>
                        <button type="button" class="btn btn-light" title="Centre" @onclick='() => Exec("justifyCenter")' @onmousedown:preventDefault><span class="oi oi-align-center"></span></button>
                        <button type="button" class="btn btn-light" title="Align right" @onclick='() => Exec("justifyRight")' @onmousedown:preventDefault><span class="oi oi-align-right"></span></button>
                        <button type="button" class="btn btn-light" title="Justify" @onclick='() => Exec("justifyFull")' @onmousedown:preventDefault><span class="oi oi-justify-center"></span></button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Lists and indent">
                        <button type="button" class="btn btn-light" title="Bulleted list" @onclick='() => Exec("insertUnorderedList")' @onmousedown:preventDefault><span class="oi oi-list"></span></button>
                        <button type="button" class="btn btn-light se-fmt-num" title="Numbered list" @onclick='() => Exec("insertOrderedList")' @onmousedown:preventDefault>1.</button>
                        <button type="button" class="btn btn-light" title="Decrease indent" @onclick='() => Exec("outdent")' @onmousedown:preventDefault>⇤</button>
                        <button type="button" class="btn btn-light" title="Increase indent" @onclick='() => Exec("indent")' @onmousedown:preventDefault>⇥</button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Link and clear">
                        <button type="button" class="btn btn-light" title="Make a link" @onclick='() => Exec("createLink")' @onmousedown:preventDefault><span class="oi oi-link-intact"></span></button>
                        <button type="button" class="btn btn-light" title="Remove formatting" @onclick='() => Exec("removeFormat")' @onmousedown:preventDefault><span class="oi oi-ban"></span></button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="History">
                        <button type="button" class="btn btn-light" title="Undo (Ctrl+Z)" @onclick='() => Exec("undo")' @onmousedown:preventDefault><span class="oi oi-action-undo"></span></button>
                        <button type="button" class="btn btn-light" title="Redo (Ctrl+Y)" @onclick='() => Exec("redo")' @onmousedown:preventDefault><span class="oi oi-action-redo"></span></button>
                    </div>
                    <span class="flex-grow-1 se-edit-status">
                        @if (draftPaths.Length > 0)
                        {
                            <strong>Unsaved changes</strong>
                            @(advanced ? $" on {string.Join(", ", draftPaths)}. Review them to save." : " (highlighted in yellow). Review them to save.")
                        }
                        else
                        {
                            @($"Click text and type. Ctrl+click a button or link to go where it leads. Right-click a link, button or image to edit it.")
                        }
                    </span>
                    @if (draftPaths.Length > 0)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DiscardDrafts">Discard</button>
                        <button type="button" class="btn btn-sm btn-primary" title="See what changed, then save (Ctrl+S)" @onclick="() => ReviewDrafts(null)">
                            <span class="oi oi-check me-1" aria-hidden="true"></span>Review and save
                        </button>
                    }
                </div>
            }
            <div class="se-stage @(frameWidth is null ? "" : "narrow")">
                <iframe @ref="frame" title="Course preview" style="@(frameWidth is null ? "" : $"width:{frameWidth}px")"></iframe>
            </div>
            <div class="se-lms" @ref="lmsHost" hidden="@(!advanced)"></div>
            </div>

            @* CodeMirror owns the host element; Blazor only renders the overlay beside it. *@
            <div class="se-panel" role="tabpanel" aria-label="Code" hidden="@(tab != Tab.Code)">
            <div class="se-editor-wrap">
                <div class="se-editor" @ref="editorHost"></div>
                @if (currentPath is null || !ScormPackage.IsText(currentPath))
                {
                    <div class="se-editor-blank">
                        @if (currentPath is null)
                        {
                            <span class="text-muted">Pick a file on the left to edit its source.</span>
                        }
                        else
                        {
                            @if (ScormPreviewEndpoints.ContentTypeOf(currentPath).StartsWith("image/"))
                            {
                                <img src="@PreviewUrl(currentPath)?v=@version" alt="@currentPath" />
                            }
                            <span class="text-muted small">@currentPath · @FormatSize(Package?.Read(currentPath)?.Length ?? 0) · @ScormPreviewEndpoints.ContentTypeOf(currentPath)</span>
                            <label class="btn btn-sm btn-outline-primary mb-0">
                                Replace file…
                                <InputFile OnChange="ReplaceFile" class="d-none" />
                            </label>
                        }
                    </div>
                }
            </div>
            </div>
        </section>

        @if (termsOpen && terms is not null)
        {
            <section class="se-pane se-terms" aria-label="Word check">
                <div class="se-pane-header">
                    <span class="flex-grow-1">Word check</span>
                    <button type="button" class="btn btn-sm btn-link p-0" title="Copy the counts as text" @onclick="CopyTermReport">Copy report</button>
                    <button type="button" class="btn btn-sm btn-link p-0 ms-2" title="@(terms.Editing ? "Close the word list" : "Change the word list")" @onclick="ToggleTermEditor">@(terms.Editing ? "Close list" : "Edit list")</button>
                    <button type="button" class="btn-close ms-2" aria-label="Close word check" title="Close and remove the highlights" @onclick="ToggleTerms"></button>
                </div>
                @if (terms.Editing)
                {
                    <div class="se-terms-edit">
                        <label class="form-label small mb-1" for="se-terms-list">One word per line: the old word, a Tab (or <code>-&gt;</code>), then the new word.</label>
                        <textarea id="se-terms-list" class="form-control form-control-sm" rows="10" spellcheck="false" @bind="terms.Draft" @bind:event="oninput"></textarea>
                        <div class="d-flex flex-wrap gap-3 small mt-2">
                            <label class="form-check mb-0"><input type="checkbox" class="form-check-input" @bind="terms.DraftCase" /> Match case</label>
                            <label class="form-check mb-0"><input type="checkbox" class="form-check-input" @bind="terms.DraftWhole" /> Whole words only</label>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveTermList">Save and check</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => terms.Draft = TermList.Default" title="Put back the IFS Academy list">Use the default list</button>
                        </div>
                    </div>
                }
                <div class="se-terms-summary">
                    @{
                        var total = terms.Hits.Count;
                        var found = terms.Terms.Where((_, i) => terms.CourseCount(i) > 0).Count();
                        var pageTotal = terms.PageCounts.Sum();
                    }
                    <div><strong>@total @(total == 1 ? "place" : "places")</strong> in the course · @found of @terms.Terms.Count words found</div>
                    <div class="text-muted">This page: @pageTotal @(pageTotal == 1 ? "match" : "matches")@(terms.Frames > 0 ? $" (page and {terms.Frames} {(terms.Frames == 1 ? "frame" : "frames")})" : "")@(terms.PageHidden.Sum() is > 0 and var hid ? $", {hid} in hidden parts such as other tabs or slides" : "")</div>
                    <div class="se-terms-note">Words are only pointed out, never replaced. Change each one yourself where the new word keeps the meaning.</div>
                    <label class="form-check mb-0"><input type="checkbox" class="form-check-input" checked="@terms.Chips" @onchange="ToggleTermChips" /> Show the new word next to each match</label>
                    <label class="form-check mb-0"><input type="checkbox" class="form-check-input" @bind="terms.HideMissing" @bind:after="SaveTermPrefs" /> Hide words not found</label>
                    @if (terms.Blocked.Length > 0)
                    {
                        <div class="se-terms-warn">@terms.Blocked.Length @(terms.Blocked.Length == 1 ? "frame is" : "frames are") from another site and can't be checked here.</div>
                    }
                    @if (terms.Hits.Count >= TermState.MaxHits)
                    {
                        <div class="se-terms-warn">Only the first @TermState.MaxHits places are counted.</div>
                    }
                </div>
                <div class="se-pane-body se-terms-list">
                    @for (var i = 0; i < terms.Terms.Count; i++)
                    {
                        var index = i;
                        var term = terms.Terms[i];
                        var inCourse = terms.CourseCount(i);
                        var onPage = i < terms.PageCounts.Length ? terms.PageCounts[i] : 0;
                        var hidden = i < terms.PageHidden.Length ? terms.PageHidden[i] : 0;
                        if (inCourse == 0 && onPage == 0 && terms.HideMissing) continue;
                        <div class="se-term @(inCourse + onPage == 0 ? "missing" : null)">
                            <div class="se-term-row">
                                <span class="se-term-swatch" style="background:@(inCourse + onPage > 0 ? TermState.Colours[i % TermState.Colours.Length] : "transparent")"></span>
                                <button type="button" class="se-term-words" disabled="@(inCourse + onPage == 0)"
                                        title="@(inCourse + onPage > 0 ? "Show where it appears" : null)" @onclick="() => ShowTerm(index)">
                                    <span class="se-term-word">@term.Old</span>
                                    @if (term.New.Length > 0) { <span class="se-term-use">→ @term.New</span> }
                                </button>
                                @if (inCourse > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-link p-0 se-term-count" title="Show where in the course" @onclick="() => terms.Open = terms.Open == index ? null : index">
                                        @inCourse
                                    </button>
                                }
                                else
                                {
                                    <span class="se-term-count text-danger" title="@(onPage > 0 ? "Not in the course's own text. On this page it comes from the course player (its menus and buttons)." : "Not found in text learners see")">@(onPage > 0 ? "0" : "not found")</span>
                                }
                            </div>
                            @if (onPage > 0)
                            {
                                <div class="se-term-page">
                                    <span>@(terms.Position.GetValueOrDefault(index) ?? $"{onPage} on this page{(hidden > 0 ? $" ({hidden} hidden)" : "")}")</span>
                                    <button type="button" class="btn btn-sm btn-light" title="Previous on this page" aria-label="Previous" @onclick="() => TermGo(index, -1)">‹</button>
                                    <button type="button" class="btn btn-sm btn-light" title="Next on this page" aria-label="Next" @onclick="() => TermGo(index, 1)">›</button>
                                </div>
                            }
                            @if (terms.Open == index)
                            {
                                <ul class="se-term-places">
                                    @foreach (var hit in terms.Hits.Where(h => h.Term == index).Take(50))
                                    {
                                        <li>
                                            @if (ScormPackage.IsHtml(hit.Path))
                                            {
                                                <button type="button" class="se-term-place" title="Show it in the preview" @onclick="() => ShowTerm(index, hit)">
                                                    <span class="se-term-file">@hit.Path.Split('/')[^1]</span>
                                                    @(hit.Before.Length > 0 ? "…" + hit.Before : "")<mark>@hit.Text</mark>@(hit.After.Length > 0 ? hit.After + "…" : "")
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="se-term-file">@hit.Path.Split('/')[^1]</span>
                                                @(hit.Before.Length > 0 ? "…" + hit.Before : "")<mark>@hit.Text</mark>@(hit.After.Length > 0 ? hit.After + "…" : "")
                                            }
                                        </li>
                                    }
                                    @if (inCourse > 50) { <li class="text-muted">and @(inCourse - 50) more</li> }
                                </ul>
                            }
                        </div>
                    }
                    @if (terms.Terms.Count == 0)
                    {
                        <p class="small text-muted px-2">The word list is empty. Press Edit list to add words.</p>
                    }
                </div>
            </section>
        }
    </div>

    @if (review is not null)
    {
        <div class="se-review-backdrop">
            <div class="se-review" role="dialog" aria-modal="true" aria-labelledby="se-review-title">
                <div class="se-review-head">
                    <h5 id="se-review-title" class="mb-0">@(review.Drafts ? "Review changes before saving" : "Changes since the package was opened")</h5>
                    @if (review.Files.Count > 0)
                    {
                        <span class="text-muted small">
                            @review.Files.Count @(review.Files.Count == 1 ? "file" : "files") ·
                            <span class="se-plus">+@review.Files.Sum(f => f.Diff?.Added ?? 0)</span>
                            <span class="se-minus">−@review.Files.Sum(f => f.Diff?.Removed ?? 0)</span> lines
                        </span>
                    }
                </div>
                @if (review.Note is not null)
                {
                    <div class="alert alert-info py-2 px-3 mb-0 rounded-0 small">@review.Note</div>
                }
                <div class="se-review-body">
                    @if (review.Drafts && review.Edits is { } edits && review.Skip is { } skip)
                    {
                        var listed = Enumerable.Range(0, edits.Length).Where(i => EditMapper.Changes(edits[i])).ToList();
                        <div class="se-changes">
                            <div class="se-changes-head">
                                <strong>Your changes</strong>
                                <span class="text-muted small">Untick a change to leave it out. Unticked changes are thrown away when you save.</span>
                                @if (listed.Count > 1)
                                {
                                    <button type="button" class="btn btn-sm btn-link p-0 ms-auto" @onclick="() => TickAll(listed, skip.Count > 0)">@(skip.Count > 0 ? "Tick all" : "Untick all")</button>
                                }
                            </div>
                            <ul class="list-unstyled mb-0">
                                @foreach (var i in listed)
                                {
                                    var e = edits[i];
                                    var failed = review.Problems?.Any(pr => pr.Edit == i) == true;
                                    <li>
                                        <label class="se-change @(skip.Contains(i) ? "off" : null)">
                                            <input type="checkbox" class="form-check-input" checked="@(!skip.Contains(i))" @onchange="() => ToggleEdit(i)" />
                                            <span>
                                                @EditMapper.Summarize(e)
                                                <span class="text-muted small">· @e.Path.Split('/')[^1]</span>
                                                @if (failed && !skip.Contains(i))
                                                {
                                                    <span class="badge text-bg-warning ms-1">can't be saved, see below</span>
                                                }
                                            </span>
                                        </label>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    @if (!review.Drafts && review.Log is { Count: > 0 } log)
                    {
                        <div class="se-changes">
                            <div class="se-changes-head">
                                <strong>Change log</strong>
                                <span class="text-muted small">Also saved in the downloaded course as scorm-editor-changes.txt.</span>
                            </div>
                            <ul class="list-unstyled mb-0 se-log">
                                @foreach (var entry in log)
                                {
                                    <li><span class="text-muted">@entry.Time.ToOffset(Package!.TimeOffset).ToString("HH:mm")</span> <span class="text-muted">@entry.Page.Split('/')[^1]:</span> @entry.What</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (review.Problems is { Count: > 0 } problems)
                    {
                        <div class="alert alert-warning py-2 px-3 small">
                            <strong>@problems.Count @(problems.Count == 1 ? "change" : "changes") can't be saved as @(problems.Count == 1 ? "it is" : "they are") and will be left out:</strong>
                            <ul class="mb-0 ps-3">
                                @foreach (var pr in problems)
                                {
                                    <li>
                                        <span class="fw-semibold">@pr.What</span> on @pr.Page. @pr.Why
                                        @if (pr.Places > 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-dark py-0 ms-1" @onclick="() => ChangeAllPlaces(pr.Edit)">Change all @pr.Places places</button>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    @if (review.Files.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0">@(review.Drafts ? (review.Skip is { Count: > 0 } ? "No ticked changes to save." : review.Problems is { Count: > 0 } ? "Nothing else to save." : "The edits cancel out, so there is nothing to save.") : "Nothing has changed yet.")</p>
                    }
                    @foreach (var f in review.Files)
                    {
                        <section class="se-diff-file">
                            <header>
                                <span class="se-diff-path">@f.Path</span>
                                <span class="small text-muted">
                                    @f.Label
                                    @if (f.Diff is { TooLarge: false } d)
                                    {
                                        <span class="se-plus ms-2">+@d.Added</span>
                                        <span class="se-minus ms-1">−@d.Removed</span>
                                    }
                                </span>
                            </header>
                            @if (f.Warning is not null)
                            {
                                <div class="alert alert-warning py-1 px-2 m-2 small">@f.Warning</div>
                            }
                            @if (f.Diff is { TooLarge: true })
                            {
                                <p class="small text-muted px-2 py-1 mb-0">The change is too large to show line by line.</p>
                            }
                            else if (f.Diff is not null)
                            {
                                <table class="se-diff">
                                    @foreach (var (hunk, h) in f.Diff.Hunks.Select((x, i) => (x, i)))
                                    {
                                        @if (h > 0)
                                        {
                                            <tr class="se-diff-gap"><td colspan="3">⋯</td></tr>
                                        }
                                        @foreach (var line in hunk.Lines)
                                        {
                                            <tr class="se-diff-@line.Kind.ToString().ToLowerInvariant()">
                                                <td class="se-ln">@line.OldNumber</td>
                                                <td class="se-ln">@line.NewNumber</td>
                                                <td class="se-code"><span class="se-sign">@(line.Kind switch { TextDiff.Kind.Added => "+", TextDiff.Kind.Removed => "−", _ => " " })</span>@foreach (var seg in line.Segments)
                                                    {
                                                        if (seg.Changed) { <mark>@seg.Text</mark> } else { @seg.Text }
                                                    }</td>
                                            </tr>
                                        }
                                    }
                                </table>
                            }
                        </section>
                    }
                </div>
                <div class="se-review-foot">
                    @if (review.Drafts)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger me-auto" @onclick="DiscardDrafts">Discard changes</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseReview">Keep editing</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveDrafts" disabled="@(review.Files.Count == 0)">
                            <span class="oi oi-check me-1" aria-hidden="true"></span>@(review.Skip is { Count: > 0 } ? "Save ticked changes" : "Save changes")
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary" @onclick="CloseReview">Close</button>
                    }
                </div>
            </div>
        </div>
    }

    @if (find is not null)
    {
        <div class="se-review-backdrop">
            <div class="se-review se-find" role="dialog" aria-modal="true" aria-labelledby="se-find-title">
                <div class="se-review-head">
                    <h5 id="se-find-title" class="mb-0">Find and replace</h5>
                    <span class="text-muted small">Changes text learners see on every page. Code and settings are left alone.</span>
                </div>
                <form class="se-find-form" @onsubmit="RunFind" @onsubmit:preventDefault>
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <label class="form-label small mb-1" for="se-find-text">Find</label>
                            <input id="se-find-text" class="form-control form-control-sm" @bind="find.Text" @bind:event="oninput" autocomplete="off" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small mb-1" for="se-replace-text">Replace with</label>
                            <input id="se-replace-text" class="form-control form-control-sm" @bind="find.Replace" @bind:event="oninput" autocomplete="off" />
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-3 align-items-center mt-2 small">
                        <label class="form-check mb-0"><input type="checkbox" class="form-check-input" @bind="find.MatchCase" /> Match case</label>
                        <label class="form-check mb-0"><input type="checkbox" class="form-check-input" @bind="find.WholeWord" /> Whole words only</label>
                        <button type="submit" class="btn btn-sm btn-outline-primary ms-auto" disabled="@(find.Text.Trim().Length == 0)">
                            <span class="oi oi-magnifying-glass me-1" aria-hidden="true"></span>Find
                        </button>
                    </div>
                </form>
                <div class="se-review-body">
                    @if (find.Hits is { } hits)
                    {
                        @if (hits.Count == 0)
                        {
                            <p class="text-muted p-3 mb-0">“@find.Searched” wasn't found in text learners see.</p>
                        }
                        else
                        {
                            <div class="se-changes">
                                <div class="se-changes-head">
                                    <strong>@(hits.Count >= 500 ? "First 500 places" : $"{hits.Count} {(hits.Count == 1 ? "place" : "places")}")</strong>
                                    <span class="text-muted small">Untick any place you want to keep as it is.</span>
                                    @if (hits.Count > 1)
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 ms-auto" @onclick="() => TickAllHits(find.Skip.Count > 0)">@(find.Skip.Count > 0 ? "Tick all" : "Untick all")</button>
                                    }
                                </div>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var hit in hits)
                                    {
                                        var on = !find.Skip.Contains(hit.Index);
                                        <li>
                                            <label class="se-change @(on ? null : "off")">
                                                <input type="checkbox" class="form-check-input" checked="@on" @onchange="() => ToggleHit(hit.Index)" />
                                                <span>
                                                    @(hit.Before.Length > 0 ? "…" + hit.Before : "")<del>@hit.Text</del>@if (on) { <ins>@find.SearchedReplace</ins> }@(hit.After.Length > 0 ? hit.After + "…" : "")
                                                    <span class="text-muted small">· @hit.Path.Split('/')[^1]</span>
                                                </span>
                                            </label>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                </div>
                <div class="se-review-foot">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-auto" @onclick="() => find = null">Close</button>
                    @if (find.Hits is { Count: > 0 } found)
                    {
                        var count = found.Count - find.Skip.Count;
                        <button type="button" class="btn btn-sm btn-primary" @onclick="ApplyReplace" disabled="@(count == 0 || find.Stale)"
                                title="@(find.Stale ? "Press Find again first: the search changed" : null)">
                            <span class="oi oi-check me-1" aria-hidden="true"></span>Replace @count @(count == 1 ? "place" : "places")
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly (string Label, int? Width)[] Widths = [("Full", null), ("Tablet", 768), ("Phone", 390)];

    private ScormPackage? Package;
    private IJSObjectReference? module;
    private DotNetObjectReference<ScormEditorPage>? selfRef;
    private ElementReference editorHost, frame, lmsHost;

    private string? currentPath, previewPath, newPath, renamePath, status;
    private string statusKind = "info";
    private bool live = true, loading, confirmDelete;
    private enum PreviewMode { Edit, Interact }
    private PreviewMode previewMode = PreviewMode.Edit;
    private string[] draftPaths = [];
    private bool advanced, showTips = true, confirmStartOver, downloaded;
    private bool sideOpen = true;
    private Review? review;
    private int? frameWidth;
    private enum Tab { Preview, Code }
    private Tab tab = Tab.Preview;
    private bool refreshEditor;
    private int version;
    private TimeSpan timeOffset;
    private readonly HashSet<string> collapsed = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (refreshEditor && module is not null)
        {
            refreshEditor = false;
            await module.InvokeVoidAsync("refresh");
        }
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets.Url("js/scorm-editor.js"));
        selfRef = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("init", selfRef, frame, editorHost, lmsHost);
        var prefs = await module.InvokeAsync<Dictionary<string, string?>>("getPrefs");
        advanced = prefs.GetValueOrDefault("advanced") == "1";
        timeOffset = TimeSpan.FromMinutes(int.TryParse(prefs.GetValueOrDefault("tz"), out var tz) ? tz : 0);
        showTips = prefs.GetValueOrDefault("tips") != "0";
        LoadTermPrefs(prefs.GetValueOrDefault("terms"));
        // The course this tab had open before a refresh or a visit to another page of the app.
        if (Guid.TryParse(prefs.GetValueOrDefault("open"), out var openId) && Store.Get(openId) is { } kept)
        {
            if (await OpenPackage(kept, reopened: true))
                Show($"Carried on with {kept.FileName}. Saved changes are kept; edits that weren't saved in the preview were lost.", "info");
        }
        StateHasChanged();
    }

    private async Task<bool> OpenPackage(ScormPackage package, bool reopened = false)
    {
        if (Package is not null)
        {
            Package.Changed -= OnPackageChanged;
            Package.Expired -= OnPackageExpired;
            Store.Release(Package);
            if (Package.Viewers == 0) Store.Remove(Package.Id);
        }
        if (!reopened && !Store.TryAdd(package))
        {
            Package = null;
            await module!.InvokeVoidAsync("setSession", "open", null);
            Show($"The server already has {Store.Options.MaxOpenCourses} courses open, the most it allows. Try again in a few minutes, or ask someone to close a course they've finished with.", "danger");
            return false;
        }
        Store.Attach(package);
        Package = package;
        package.TimeOffset = timeOffset;
        package.Changed += OnPackageChanged;
        package.Expired += OnPackageExpired;
        draftPaths = [];
        review = null;
        downloaded = false;
        confirmStartOver = false;
        currentPath = null;
        tab = Tab.Preview;
        collapsed.Clear();
        await module!.InvokeVoidAsync("setPackage", package.Id);
        await module!.InvokeVoidAsync("setSession", "open", package.Id.ToString());
        UpdateUnsavedFlag();

        var launch = package.Manifest?.LaunchPath ?? package.Paths.FirstOrDefault(ScormPackage.IsHtml);
        var code = reopened && package.LastCodePath is { } c && package.Exists(c) ? c : launch;
        var start = reopened && package.LastPreviewPath is { } v && package.Exists(v) ? v : launch;
        await OpenFile(code ?? (package.ManifestPath.Length > 0 ? package.ManifestPath : package.Paths.FirstOrDefault()));
        await SetPreview(start);
        if (termsOpen) ScanCourseTerms();
        return true;
    }

    // The server closed the course after it went unused for the idle limit.
    private void OnPackageExpired() => _ = InvokeAsync(async () =>
    {
        if (Package is null) return;
        Package.Changed -= OnPackageChanged;
        Package.Expired -= OnPackageExpired;
        Package = null;
        review = null;
        find = null;
        termsOpen = false;
        draftPaths = [];
        UpdateUnsavedFlag();
        await module!.InvokeVoidAsync("setUnsaved", false);
        await module!.InvokeVoidAsync("setSession", "open", null);
        Show($"This course was closed after {Store.Options.IdleHours:0.#} hours without use, to free memory on the server. Open it again to keep editing.", "warning");
    });

    // Raised from the preview endpoint's request thread as well as from this circuit.
    // Raised for every save, so re-renders are batched: one per 250 ms at most. Re-rendering the
    // whole page and file tree on each keystroke was the main source of lag on large courses.
    private int renderQueued;
    private void OnPackageChanged(string path)
    {
        if (Interlocked.Exchange(ref renderQueued, 1) == 1) return;
        _ = Task.Delay(250).ContinueWith(_ => InvokeAsync(() =>
        {
            renderQueued = 0;
            version++;
            downloaded = false;
            confirmStartOver = false;
            UpdateUnsavedFlag();
            if (termsOpen) ScanCourseTerms();
            StateHasChanged();
        }));
    }

    private async Task OpenZip(InputFileChangeEventArgs e)
    {
        var maxBytes = Store.Options.MaxUploadMB * 1024L * 1024;
        if (e.File.Size > maxBytes)
        {
            Show($"{e.File.Name} is {FormatSize(e.File.Size)}. The largest course the editor can open is {Store.Options.MaxUploadMB} MB.", "danger");
            return;
        }
        loading = true;
        try
        {
            await using var upload = e.File.OpenReadStream(maxAllowedSize: maxBytes);
            using var ms = new MemoryStream();
            await upload.CopyToAsync(ms);
            ms.Position = 0;
            var package = ScormPackage.FromZip(e.File.Name, ms);
            if (draftPaths.Length > 0)
                Show($"Unsaved preview changes on {string.Join(", ", draftPaths)} were dropped when {e.File.Name} was opened.", "warning");
            if (!await OpenPackage(package)) return;
            if (status is null || statusKind != "warning") Show(package.ManifestPath.Length == 0
                ? $"Opened {e.File.Name}, but it has no imsmanifest.xml, so it is not a SCORM package yet."
                : $"Opened {e.File.Name} ({package.Paths.Count} files).", package.ManifestPath.Length == 0 ? "warning" : "success");
        }
        catch (InvalidDataException)
        {
            Show($"{e.File.Name} is not a readable .zip file.", "danger");
        }
        catch (IOException ex)
        {
            Show($"Could not read {e.File.Name}: {ex.Message}", "danger");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenFile(string? path)
    {
        if (Package is null || path is null || !Package.Exists(path)) return;
        currentPath = path;
        Package.LastCodePath = path;
        renamePath = path;
        confirmDelete = false;
        if (ScormPackage.IsText(path))
            await module!.InvokeVoidAsync("openText", path, Package.ReadText(path), ModeOf(path), false);
        else
            await module!.InvokeVoidAsync("hideEditor");
        if (live && draftPaths.Length == 0 && ScormPackage.IsHtml(path) && path != previewPath) await SetPreview(path);
    }

    private async Task EditFile(string path)
    {
        await OpenFile(path);
        ShowTab(Tab.Code);
    }

    private Task PreviewPage(string path) => AfterDrafts(async () =>
    {
        await SetPreview(path);
        ShowTab(Tab.Preview);
    });

    private Task OpenItem(ScormManifest.Item item) => AfterDrafts(async () =>
    {
        if (item.Path is null) return;
        await OpenFile(item.Path);
        await SetPreview(item.Path);
        ShowTab(Tab.Preview);
    });

    private Task PickPreview(string? path) => AfterDrafts(() => SetPreview(path));

    private async Task SetPreview(string? path)
    {
        previewPath = path;
        if (Package is not null) Package.LastPreviewPath = path;
        await module!.InvokeVoidAsync("loadPreview", path);
    }

    private Task ReloadPreview() => AfterDrafts(async () =>
    {
        await module!.InvokeVoidAsync("flush");
        await module!.InvokeVoidAsync("reloadPreview");
    });

    private async Task ToggleLive(ChangeEventArgs e)
    {
        live = e.Value is true;
        await module!.InvokeVoidAsync("setLive", live);
    }

    private Task SetMode(PreviewMode mode) => mode == previewMode ? Task.CompletedTask : AfterDrafts(async () =>
    {
        previewMode = mode;
        await module!.InvokeVoidAsync("setMode", mode == PreviewMode.Edit ? "edit" : "interact");
    });

    private string textColour = "#c00000", markColour = "#ffe14d";

    private async Task Exec(string command, string? value = null)
