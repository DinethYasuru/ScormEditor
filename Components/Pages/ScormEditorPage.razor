        _ = module?.InvokeVoidAsync("setPref", "tips", "0").AsTask();
    }

    // Puts every file back as it was in the opened package. Asks once by turning the button red.
    private Task StartOver() => AfterDrafts(async () =>
    {
        if (Package is null) return;
        if (!confirmStartOver) { confirmStartOver = true; return; }
        confirmStartOver = false;
        foreach (var path in Package.ChangedPaths)
        {
            if (Package.HasOriginal(path)) Package.Revert(path);
            else Package.Delete(path);
            await module!.InvokeVoidAsync("forget", path);
        }
        Package.ClearHistory();
        if (currentPath is not null && Package.Exists(currentPath)) await OpenFile(currentPath);
        else currentPath = null;
        await module!.InvokeVoidAsync("reloadPreview");
        Show("Undid every change. The course is back to how it was when you opened it.", "info");
    });

    // The browser asks before closing the tab while there are changes not yet downloaded.
    private void UpdateUnsavedFlag() =>
        _ = module?.InvokeVoidAsync("setUnsaved", Package is { ChangeCount: > 0 } && !downloaded).AsTask();

